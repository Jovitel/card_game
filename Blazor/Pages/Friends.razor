@page "/friends"
@using CardGame.Shared.Models
@inject HttpClient Http
@inject UserSession UserSession

<div class="friends-page">
    <h2>Draugų puslapis</h2>

    <div class="friends-layout">
        <!-- Kairė pusė - Draugų sąrašas -->
        <div class="friends-list">
            <h3>Tavo draugai</h3>

            @if (friends == null)
            {
                <p>Kraunama...</p>
            }
            else if (!friends.Any())
            {
                <p>Dar neturi draugų</p>
            }
            else
            {
                <table class="friends-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Vardas</th>
                            <th>Laimėjimai</th>
                            <th>Pralaimėjimai</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (f, idx) in friends.Select((f, i) => (f, i + 1)))
                        {
                            <tr>
                                <td>@idx</td>
                                <td>@f.UserName</td>
                                <td>@f.Wins</td>
                                <td>@f.Losses</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <!-- Dešinė pusė - Paieška -->
        <div class="friends-search">
            <h3>Rasti naują draugą</h3>
            <div class="search-section">
                <input type="text" @bind="searchQuery" placeholder="Įvesk vartotojo vardą..." class="search-input" />
                <button class="btn btn-search" @onclick="SearchUser">Ieškoti</button>
            </div>

            @if (searchResults != null && searchResults.Any())
            {
                <div class="results">
                    <h4>Rezultatai:</h4>
                    <ul>
                        @foreach (var u in searchResults)
                        {
                            <li>
                                <span><b>@u.UserName</b> (W: @u.Wins, L: @u.Losses)</span>
                                @if ((friends?.Any(f => f.Id == u.Id)) == true)
                                {
                                    <button class="btn btn-disabled" disabled>Jau draugas</button>
                                }
                                else if (u.Id == UserSession.UserId)
                                {
                                    <button class="btn btn-disabled" disabled>Tu pats</button>
                                }
                                else
                                {
                                    <button class="btn btn-add" @onclick="() => AddFriend(u.Id)">Pridėti</button>
                                }
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>

    <NavLink href="/start" class="btn-floating-back">← Grįžti</NavLink>
</div>


@code {
    private string searchQuery = "";
    private List<User> searchResults = new();
    private List<User> friends = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadFriends();
    }

    private async Task LoadFriends()
    {
        if (UserSession.UserId <= 0)
        {
            friends = new();
            return;
        }

        friends = await Http.GetFromJsonAsync<List<User>>($"api/friends/{UserSession.UserId}") ?? new();
        StateHasChanged();
    }

    private async Task SearchUser()
    {
        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            searchResults.Clear();
            return;
        }

        searchResults = await Http.GetFromJsonAsync<List<User>>($"api/friends/search/{searchQuery}") ?? new();
        StateHasChanged();
    }

    private async Task AddFriend(int friendId)
    {
        if (UserSession.UserId <= 0) return;

        await Http.PostAsync($"api/friends/{UserSession.UserId}/add/{friendId}", null);
        await LoadFriends();
        searchResults.Clear();
    }
}

<style>
.friends-page {
    padding: 30px;
    background-color: #2c425a;
    color: #f0e1b4;
    min-height: 100vh;
}

h2, h3, h4 {
    color: #f0e1b4;
    text-align: center;
    margin-bottom: 20px;
}



.search-section {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
}

.search-input {
    padding: 8px 12px;
    border-radius: 8px;
    border: 2px solid #f0e1b4;
    width: 250px;
    background: #fff;
    color: #1c2d3e;
}

.results ul {
    list-style: none;
    padding: 0;
    max-width: 500px;
    margin: 0 auto;
}

.results li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: #a2c2de;
    padding: 8px 14px;
    margin-bottom: 8px;
    border-radius: 8px;
    color: #1c2d3e;
}

.btn {
    padding: 6px 12px;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 600;
    transition: 0.2s ease;
}

.btn-search {
    background-color: #3a5a8c;
    color: #fff;
}

.btn-add {
    background-color: #5a8c3a;
    color: #fff;
}

.btn-disabled {
    background-color: #aaa;
    color: #eee;
    cursor: not-allowed;
}

.btn-search:hover {
    background-color: #507bc0;
}

.btn-add:hover {
    background-color: #6cae48;
}
.btn-back {
    background-color: #3a5a8c;
    color: #fff;
    padding: 8px 14px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    margin-bottom: 15px;
    display: inline-block;
}
.btn-back:hover {
    background-color: #507bc0;
}

.btn-floating-back {
    position: fixed;
    bottom: 30px;
    right: 30px;
    background-color: #3a5a8c;
    color: #fff;
    padding: 10px 18px;
    border-radius: 10px;
    text-decoration: none;
    font-weight: 600;
    box-shadow: 0 4px 8px rgba(0,0,0,0.3);
    transition: 0.3s;
}

.btn-floating-back:hover {
    background-color: #507bc0;
    transform: translateY(-2px);
}
.friends-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: start;
    margin-top: 20px;
}

.friends-list, .friends-search {
    border-radius: 12px;
    padding: 20px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.2);
}

.friends-list {
    color: #f0e1b4;
}

.friends-search {
    color: #1c2d3e;
}

.friends-table {
    width: 100%;
    border-collapse: collapse;
}

.friends-table th, .friends-table td {
    border-bottom: 2px solid #2c425a;
    padding: 8px 10px;
    text-align: center;
}

</style>

