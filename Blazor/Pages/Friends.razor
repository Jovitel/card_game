@page "/friends"
@using CardGame.Shared.Models
@inject HttpClient Http
@inject UserSession UserSession

<div class="friends-page">
    <h2>Friends</h2>

    <div class="friends-layout">
        <!-- Kairė pusė - Draugų sąrašas -->
        <div class="friends-list">
            <h3>Your friends</h3>

            @if (friends == null)
            {
                <p>Loading...</p>
            }
            else if (!friends.Any())
            {
                <p>You do not have any friends yet...</p>
            }
            else
            {
                <table class="friends-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th>Wins</th>
                            <th>Losses</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (f, idx) in friends.Select((f, i) => (f, i + 1)))
                        {
                            <tr>
                                <td>@idx</td>
                                <td>@f.UserName</td>
                                <td>@f.Wins</td>
                                <td>@f.Losses</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <!-- Dešinė pusė - Paieška -->
        <div class="friends-search">
            <h3>Find friends</h3>
            <div class="search-section">
                <input type="text" @bind="searchQuery" placeholder="Įvesk vartotojo vardą..." class="search-input" />
                <button class="btn btn-search" @onclick="SearchUser">Search</button>
            </div>

            @if (searchResults != null && searchResults.Any())
            {
                <div class="results">
                    <h4>Results:</h4>
                    <ul>
                        @foreach (var u in searchResults)
                        {
                            <li>
                                <span><b>@u.UserName</b> (W: @u.Wins, L: @u.Losses)</span>
                                @if ((friends?.Any(f => f.Id == u.Id)) == true)
                                {
                                    <button class="btn btn-disabled" disabled>Friend</button>
                                }
                                else if (u.Id == UserSession.UserId)
                                {
                                    <button class="btn btn-disabled" disabled>You</button>
                                }
                                else
                                {
                                    <button class="btn btn-add" @onclick="() => AddFriend(u.Id)">Add</button>
                                }
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>

    <NavLink href="/start" class="btn-floating-back">Exit</NavLink>
</div>


@code {
    private string searchQuery = "";
    private List<User> searchResults = new();
    private List<User> friends = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadFriends();
    }

    private async Task LoadFriends()
    {
        if (UserSession.UserId <= 0)
        {
            friends = new();
            return;
        }

        friends = await Http.GetFromJsonAsync<List<User>>($"api/friends/{UserSession.UserId}") ?? new();
        StateHasChanged();
    }

    private async Task SearchUser()
    {
        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            searchResults.Clear();
            return;
        }

        searchResults = await Http.GetFromJsonAsync<List<User>>($"api/friends/search/{searchQuery}") ?? new();
        StateHasChanged();
    }

    private async Task AddFriend(int friendId)
    {
        if (UserSession.UserId <= 0) return;

        await Http.PostAsync($"api/friends/{UserSession.UserId}/add/{friendId}", null);
        await LoadFriends();
        searchResults.Clear();
    }
}
<style>
/* Tik unikalūs šio puslapio stiliai, be spalvų (spalvas ima iš themes.css) */
.friends-page {
    padding: 30px;
    min-height: 100vh;
}

h2, h3, h4 {
    text-align: center;
    margin-bottom: 20px;
}

/* Maketavimas */
.friends-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: start;
    margin-top: 20px;
}

.friends-list, .friends-search {
    border-radius: 12px;
    padding: 20px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.2);
}

/* Paieškos sekcija */
.search-section {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
}

/* Input */
.search-input {
    padding: 8px 12px;
    border-radius: 8px;
    width: 250px;
}

/* Rezultatų blokas */
.results ul {
    list-style: none;
    padding: 0;
    max-width: 500px;
    margin: 0 auto;
}

.results li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: var(--container-bg);
    padding: 8px 14px;
    margin-bottom: 8px;
    border-radius: 8px;
    color: var(--text-color);
}

/* Lentelė */
.friends-table {
    width: 100%;
    border-collapse: collapse;
}

.friends-table th, .friends-table td {
    border-bottom: 2px solid var(--accent-color);
    padding: 8px 10px;
    text-align: center;
}

/* Fiksuotas grįžimo mygtukas */
.btn-floating-back {
    position: fixed;
    bottom: 30px;
    right: 30px;
    padding: 10px 18px;
    border-radius: 10px;
    box-shadow: 0 4px 8px rgba(0,0,0,0.3);
    transition: 0.3s;
}
.btn-floating-back:hover {
    transform: translateY(-2px);
}
</style>
