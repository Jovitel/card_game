@page "/gamehistory"
@using CardGame.Shared.Models   
@layout MainLayout
@inject UserSession UserSession
@inject NavigationManager NavigationManager

<div class="group">
    <h3>Game History</h3>
    <button class="btn" @onclick="GoBack">Main Menu</button>
</div>


@if (history == null || !history.Any())
{
    <p>Nėra žaidimų istorijos.</p>
}
else
{
    <div class="table-container">
        <table class="history-table">
            <thead>
                <tr>
                    <th>Player</th>
                    <th>Action</th>
                    <th>Cards</th>
                    <th>Time</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var entry in history)
                {
                    <tr>
                        <td>@entry.Player</td>
                        <td>@entry.Action</td>
                        <td>
                            @if(entry.CardPlayed != null)
                            {
                                @entry.CardPlayed   @* tiesiog string, nereikia Value/Suit *@
                            }
                            @if(entry.AttackCard != null)
                            {
                                <span>(Atack: @entry.AttackCard)</span>
                            }
                        </td>
                        <td>@entry.TimeStamp.ToString("HH:mm:ss")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
@code {
    private List<GameHistoryEntry> history = new();

    protected override void OnInitialized()
    {
        // Paprasčiausiai paimame istoriją iš UserSession
        // Čia galima laikyti globalią istoriją per servisą
        history = UserSession.GameHistory;
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/start");
    }
}
<style>


body {
    background-color: var(--bg-color);
}

/* Centrinis konteineris lentelėms */
.table-container {
    display: flex;
    justify-content: center;
    padding: 20px;
}

/* Lentelės antraštės ir langeliai */
.history-table th,
.history-table td {
    padding: 12px 15px;
    text-align: center;
}

/* Antraštės – naudoja akcentinę spalvą iš temos */
.history-table th {
    background-color: var(--accent-color);
    color: var(--highlight-color);
    font-weight: bold;
    text-transform: uppercase;
}

/* Eilutės – automatiškai pagal temą */
.history-table tbody tr {
    background-color: var(--container-bg);
    transition: background-color 0.3s;
}

/* Kas antra eilutė – šiek tiek šviesesnė */
.history-table tbody tr:nth-child(even) {
    background-color: color-mix(in srgb, var(--container-bg) 80%, white);
}

/* Užvedus paryškinama – imama iš highlight */
.history-table tbody tr:hover {
    background-color: var(--highlight-color);
}

/* Bendri mygtukai – stilius jau ateina iš themes.css */
.btn {
    min-width: 180px;
    max-height: 50px;
}

/* Lankstus grupės konteineris */
.group {
    margin-top: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 20px 20px 20px;
}
</style>
