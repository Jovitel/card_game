@page "/gamehistory"
@using CardGame.Shared.Models   
@layout MainLayout
@inject UserSession UserSession
@inject NavigationManager NavigationManager

<div class="group">
    <h3>Game History</h3>
    <button class="btn" @onclick="GoBack">Main Menu</button>
</div>


@if (history == null || !history.Any())
{
    <p>Nėra žaidimų istorijos.</p>
}
else
{
    <div class="table-container">
        <table class="history-table">
            <thead>
                <tr>
                    <th>Player</th>
                    <th>Action</th>
                    <th>Cards</th>
                    <th>Time</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var entry in history)
                {
                    <tr>
                        <td>@entry.Player</td>
                        <td>@entry.Action</td>
                        <td>
                            @if(entry.CardPlayed != null)
                            {
                                @entry.CardPlayed   @* tiesiog string, nereikia Value/Suit *@
                            }
                            @if(entry.AttackCard != null)
                            {
                                <span>(Atack: @entry.AttackCard)</span>
                            }
                        </td>
                        <td>@entry.TimeStamp.ToString("HH:mm:ss")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
@code {
    private List<GameHistoryEntry> history = new();

    protected override void OnInitialized()
    {
        // Paprasčiausiai paimame istoriją iš UserSession
        // Čia galima laikyti globalią istoriją per servisą
        history = UserSession.GameHistory;
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/start");
    }
}

<style>
body {
    background-color: #a2c2de; /* arba kita spalva pagal dizainą */
}
/* centrinis konteineris lentelėms */
.table-container {
    display: flex;
    justify-content: center;   /* horizontalus centras */
    padding: 20px;
}
.history-table th, .history-table td {
    padding: 12px 15px;
    text-align: center;
}

.history-table th {
    background-color: #2c425a; /* tamsiai mėlyna antraštė */
    color: #f0e1b4;            /* šviesus tekstas */
    font-weight: bold;
    text-transform: uppercase;
}

.history-table tbody tr {
    background-color: #f2f2f2;  /* šviesus fonas eilutėms */
    transition: background-color 0.3s;
}

.history-table tbody tr:nth-child(even) {
    background-color: #e0e0e0;  /* kitokia spalva kas antrai eilutei */
}

.history-table tbody tr:hover {
    background-color: #f0e1b4; /* paryškintas hover */
}
.btn {
    background-color: #2c425a;
    color: white;
    padding: 12px;
    border: none;
    border-radius: 8px;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
    transition: 0.3s;
    text-decoration: none;
    text-align: center;
    min-width: 180px;
    max-height: 50px;
}

.btn:hover  {
    background-color: #56708c;
    color: #f0e1b4;
}
.group {
    margin-top: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;  
    padding: 0 20px 20px 20px; /* padding: top right bottom left */

}
</style>
