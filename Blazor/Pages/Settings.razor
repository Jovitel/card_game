
@page "/settings"
@layout MainLayout
@using card_game.Services
@inject CardSettingsService CardSettingsService

<div class="page-wrapper">
    <div class="container">
        <div class="top-line">
            <img src="images/durnius.png" alt="Žaidimo nuotrauka" class="top-image" />
            <NavLink class="btn" href="/start">Exit</NavLink>
        </div>

        <div class="settings-section">
            <h2>Card Design</h2>
            <div class="color-options">
                <button class="color-btn red-btn @(CardSettingsService.SelectedCardColor == "red" ? "selected" : "")" 
                        @onclick="SelectRed"></button>
                
                <button class="color-btn blue-btn @(CardSettingsService.SelectedCardColor == "blue" ? "selected" : "")" 
                        @onclick="SelectBlue"></button>
                
                <button class="color-btn green-btn @(CardSettingsService.SelectedCardColor == "green" ? "selected" : "")" 
                        @onclick="SelectGreen"></button>

                <button class="color-btn pink-btn @(CardSettingsService.SelectedCardColor == "pink" ? "selected" : "")" 
                        @onclick="SelectPink"></button>
            </div>
            <h2>Table Design</h2>
            <div class="color-options">
                <button class="color-btn darkblue-bg @(CardSettingsService.SelectedTableColor == "#2c425a" ? "selected" : "")" 
                        @onclick="SelectDarkBlueBg"></button>
                
                <button class="color-btn green-bg @(CardSettingsService.SelectedTableColor == "#134628ff" ? "selected" : "")" 
                        @onclick="SelectGreenBg"></button>
                
                <button class="color-btn darkred-bg @(CardSettingsService.SelectedTableColor == "#943126" ? "selected" : "")" 
                        @onclick="SelectDarkRedBg"></button>

                <button class="color-btn darkpink-bg @(CardSettingsService.SelectedTableColor == "#5c0b45ff" ? "selected" : "")" 
                        @onclick="SelectDarkPinkBg"></button>
            </div>
        </div>
    </div>
</div>

@code {
   private void SelectRed()
    {
        CardSettingsService.SetCardColor("red");
    }

    private void SelectBlue()
    {
        CardSettingsService.SetCardColor("blue");
    }
    
    private void SelectGreen()
    {
        CardSettingsService.SetCardColor("green");
    }
    private void SelectPink()
    {
        CardSettingsService.SetCardColor("pink");
    }


    private void SelectDarkBlueBg()
    {
        CardSettingsService.SetTableColor("#2c425a");
    }

    private void SelectGreenBg()
    {
        CardSettingsService.SetTableColor("#134628ff"); // Standartinė kazino žalia
    }
    
    private void SelectDarkRedBg()
    {
        CardSettingsService.SetTableColor("#943126"); // Tamsi burgundijos raudona
    }

    private void SelectDarkPinkBg()
    {
        CardSettingsService.SetTableColor("#5c0b45ff"); 
    }
}

<style>
/* Esami stiliai */
.page-wrapper {
    background-color: #2c425a;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    padding: 5px;
    box-sizing: border-box;
}

.container {
    background: #a2c2de;
    width: 98%;
    max-width: 1300px;
    min-height: 500px;
    padding: 10px;
    border-radius: 12px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.2);
    display: flex;
    flex-direction: column;
    align-items: center;
}
.top-line {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    margin-bottom: 30px;
}

.top-image {
    width: 230px;
    height: auto;
    border-radius: 12px;
}

.btn {
    background-color: #2c425a;
    color: white;
    padding: 12px;
    border: 3px;
    border-radius: 8px;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
    transition: 0.3s;
    text-decoration: none;
    text-align: center;
    min-width: 180px;
}

.btn:hover {
    background-color: #56708c;
    color: #f0e1b4;
}

/* Nauji nustatymų sekcijos stiliai */
.settings-section {
    width: 100%;
    max-width: 800px;
    margin-top: 20px;
    padding: 20px;
    border-radius: 8px;
   
}

.settings-section h2 {
    color: #2c425a;
    border-bottom: 2px solid #2c425a;
    padding-bottom: 10px;
    margin-bottom: 20px;
    text-align: center;
}

.color-options {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-bottom: 20px;
}

.color-btn {
    padding: 10px 20px;
    border: 3px solid transparent;
    border-radius: 6px;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.2s;
}

.color-btn:hover {
    opacity: 0.8;
}

/* Pasirinktas mygtukas */
.color-btn.selected {
    border-color: #2c425a; 
    transform: scale(1.05);
    box-shadow: 0 0 10px rgba(0,0,0,0.3);
}

/* Spalvų mygtukų stiliai */
.red-btn { background-color: #c41e3a; color: white; }
.blue-btn { background-color: #1e6ec4; color: white; }
.green-btn { background-color: #38a538; color: white; }
.pink-btn { background-color: #e32092ff; color: white; }



.darkblue-bg { 
    background-color: #2c425a; 
    color: white; 
}
.green-bg { 
    background-color: #134628ff; 
    color: white; 
}
.darkred-bg { 
    background-color: #943126; 
    color: white; 
}

.darkpink-bg { 
    background-color: #5c0b45ff; 
    color: white; 
}
</style>

