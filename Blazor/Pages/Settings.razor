@page "/settings"
@layout MainLayout
@using card_game.Services
@inject ThemeService ThemeService
@inject CardSettingsService CardSettingsService
@inject UserSession Session
@inject HttpClient Http 
@inject NavigationManager NavigationManager 
<div class="page-wrapper">
    <div class="container">
        <div class="top-line">
            <img src="images/durnius.png" alt="Žaidimo nuotrauka" class="top-image" />
            <NavLink class="btn" href="/start">Exit</NavLink>
        </div>
        
        <div class="settings-section">
            <h2>Avatar Design</h2>
           <div class="color-options"> 
                <button class="color-btn avatar-btn @(Session.SelectedAvatarUrl.EndsWith("avatar1.png") ? "selected" : "")" 
                        @onclick="@(() => SelectAvatar("images/avatar1.png"))"> 
                    <img src="images/avatar1.png" alt="Avatar 1" class="avatar-image"/>
                </button>
                
                <button class="color-btn avatar-btn @(Session.SelectedAvatarUrl.EndsWith("avatar2.png") ? "selected" : "")" 
                        @onclick="@(() => SelectAvatar("images/avatar2.png"))"> 
                    <img src="images/avatar2.png" alt="Avatar 2" class="avatar-image"/>
                </button>
                
                <button class="color-btn avatar-btn @(Session.SelectedAvatarUrl.EndsWith("default_avatar.png") ? "selected" : "")" 
                        @onclick="@(() => SelectAvatar("images/default_avatar.png"))">
                    <img src="images/default_avatar.png" alt="Avatar Default" class="avatar-image"/>
                </button>
                
                <button class="color-btn avatar-btn @(Session.SelectedAvatarUrl.EndsWith("avatar3.png") ? "selected" : "")" 
                        @onclick="@(() => SelectAvatar("images/avatar3.png"))"> 
                    <img src="images/avatar3.png" alt="Avatar 3" class="avatar-image"/>
                </button>

                <button class="color-btn avatar-btn @(Session.SelectedAvatarUrl.EndsWith("avatar4.png") ? "selected" : "")" 
                        @onclick="@(() => SelectAvatar("images/avatar4.png"))"> 
                    <img src="images/avatar4.png" alt="Avatar 4" class="avatar-image"/>
                </button>
            </div>
            <h2>Card Design</h2>
            <div class="color-options">
                <button class="color-btn red-btn @(CardSettingsService.SelectedCardColor == "red" ? "selected" : "")" 
                        @onclick="SelectRed"></button>
                
                <button class="color-btn blue-btn @(CardSettingsService.SelectedCardColor == "blue" ? "selected" : "")" 
                        @onclick="SelectBlue"></button>
                
                <button class="color-btn green-btn @(CardSettingsService.SelectedCardColor == "green" ? "selected" : "")" 
                        @onclick="SelectGreen"></button>

                <button class="color-btn pink-btn @(CardSettingsService.SelectedCardColor == "pink" ? "selected" : "")" 
                        @onclick="SelectPink"></button>
            </div>
            <h2>Table Design</h2>
            <div class="color-options">
                <button class="color-btn darkblue-bg @(CardSettingsService.SelectedTableColor == "#2c425a" ? "selected" : "")" 
                        @onclick="SelectDarkBlueBg"></button>
                
                <button class="color-btn green-bg @(CardSettingsService.SelectedTableColor == "#134628ff" ? "selected" : "")" 
                        @onclick="SelectGreenBg"></button>
                
                <button class="color-btn darkred-bg @(CardSettingsService.SelectedTableColor == "#943126" ? "selected" : "")" 
                        @onclick="SelectDarkRedBg"></button>

                <button class="color-btn darkpink-bg @(CardSettingsService.SelectedTableColor == "#5c0b45ff" ? "selected" : "")" 
                        @onclick="SelectDarkPinkBg"></button>
            </div>
            <h2>Theme</h2>
<div class="color-options">
    <button class="btn theme-toggle" @onclick="ToggleTheme">
        @(ThemeService.IsDarkMode ? "Switch to Light Mode" : "Switch to Dark Mode")
    </button>
</div>

        </div>
    </div>
</div>

@code {
    private async Task SaveSettingsToDb(string settingType, string value)
    {
        if (Session.CurrentUser == null || Session.UserId <= 0)
        {
            Console.WriteLine("Vartotojas neprisijungęs. Nustatymai nebus išsaugoti DB.");
            return;
        }
        
        try
        {
            // Šis 'payload' siųs duomenis, kad serveris žinotų, ką atnaujinti
            var payload = new 
            { 
                UserId = Session.UserId, 
                SettingType = settingType, // Pvz., "CardColor" arba "TableColor"
                Value = value
            };
            
            // Jums reikės sukurti API endpointą: api/users/updatesetting
            var response = await Http.PostAsJsonAsync("api/users/updatesetting", payload); 

            if (!response.IsSuccessStatusCode)
            {
                Console.WriteLine($"Klaida išsaugant {settingType} DB: " + response.StatusCode);
            }
            else
            {
                // Atnaujinam UserSession objektą su nauja reikšme
                if (settingType == "CardColor")
                    Session.CurrentUser.SelectedCardColor = value;
                else if (settingType == "TableColor")
                    Session.CurrentUser.SelectedTableColor = value;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Klaida siunčiant {settingType} atnaujinimą: " + ex.Message);
        }
    }
    private async Task SelectRed()
    {
        CardSettingsService.SetCardColor("red");
        await SaveSettingsToDb("CardColor", "red");
    }

    private async Task SelectBlue()
    {
        CardSettingsService.SetCardColor("blue");
        await SaveSettingsToDb("CardColor", "blue");
    }
    
    private async Task SelectGreen()
    {
        CardSettingsService.SetCardColor("green");
        await SaveSettingsToDb("CardColor", "green");
    }
    private async Task SelectPink()
    {
        CardSettingsService.SetCardColor("pink");
        await SaveSettingsToDb("CardColor", "pink");
    }

    private async Task SelectDarkBlueBg()
    {
        string color = "#2c425a";
        CardSettingsService.SetTableColor(color);
        await SaveSettingsToDb("TableColor", color);
    }

    private async Task SelectGreenBg()
    {
        string color = "#134628ff";
        CardSettingsService.SetTableColor(color);
        await SaveSettingsToDb("TableColor", color);
    }
    
    private async Task SelectDarkRedBg()
    {
        string color = "#943126";
        CardSettingsService.SetTableColor(color);
        await SaveSettingsToDb("TableColor", color);
    }

    private async Task SelectDarkPinkBg()
    {
        string color = "#5c0b45ff";
        CardSettingsService.SetTableColor(color);
        await SaveSettingsToDb("TableColor", color);
    }

    private async Task SelectAvatar(string url)
    {
        if (Session.CurrentUser == null || Session.UserId <= 0)
        {
            // Jei vartotojas neprisijungęs, tiesiog nustatome vietiniam UI ir išeiname
            Session.SetAvatar(url);
            return;
        }

        // 1. Vietinis atnaujinimas
        Session.SetAvatar(url); 
        
        // 2. Išsaugome DB: siunčiame atnaujintą vartotojo objektą ar tik URL
        try
        {

            var payload = new { UserId = Session.UserId, AvatarUrl = url };
            
            var response = await Http.PostAsJsonAsync("api/users/updateavatar", payload); 

            if (!response.IsSuccessStatusCode)
            {
                Console.WriteLine("Klaida išsaugant avatarą DB: " + response.StatusCode);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Klaida siunčiant avataro atnaujinimą: " + ex.Message);
        }
    }
    private async Task ToggleTheme()
    {
        await ThemeService.ToggleTheme();
    }

    protected override async Task OnInitializedAsync()
    {
        // 1. Inicializuojame temą (esamas kodas)
        await ThemeService.InitializeAsync();
        
        // 2. NAUJAS KODAS: Įkeliame Kortų ir Stalo spalvas iš DB (per UserSession)
        if (Session.CurrentUser != null)
        {
            // Atnaujiname CardSettingsService su DB nustatymais
            CardSettingsService.SetCardColor(Session.CurrentUser.SelectedCardColor);
            CardSettingsService.SetTableColor(Session.CurrentUser.SelectedTableColor);
            
            // Atnaujiname avataro URL, kad būtų parodytas teisingas pasirinkimas
            Session.SetAvatar(Session.CurrentUser.AvatarUrl);
        }
    }

}
<style>
/* Bendras puslapio fonas */
.page-wrapper {
    background-color: var(--bg-color);
    color: var(--text-color);
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    padding: 20px;
    box-sizing: border-box;
    transition: background-color 0.3s, color 0.3s;
}

/* Vidinis konteineris */
.container {
    background-color: var(--container-bg);
    width: 98%;
    max-width: 1300px;
    min-height: 500px;
    padding: 20px;
    border-radius: 12px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.25);
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: background-color 0.3s, color 0.3s;
}

/* Viršutinė juosta su nuotrauka ir mygtuku */
.top-line {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    margin-bottom: 30px;
}

.top-image {
    width: 230px;
    height: auto;
    border-radius: 12px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
}

/* Bendras mygtukų stilius (naudoja globalius kintamuosius) */
.btn {
    background-color: var(--btn-bg);
    color: var(--btn-text);
    padding: 12px;
    border: none;
    border-radius: 8px;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    text-align: center;
    min-width: 150px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.4);
}

.btn:hover {
    background-color: var(--btn-bg-hover);
    color: var(--btn-text-hover);
}

/* Pagrindinė nustatymų sekcija */
.settings-section {
    width: 100%;
    max-width: 800px;
    margin-top: 20px;
    padding: 20px;
    border-radius: 10px;
    background-color: var(--section-bg);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
    transition: background-color 0.3s, color 0.3s;
}

/* Sekcijos antraštės */
.settings-section h2 {
    color: var(--highlight-color);
    border-bottom: 2px solid var(--accent-color);
    padding-bottom: 10px;
    margin-bottom: 20px;
    text-align: center;
}

/* Spalvų pasirinkimo eilutės */
.color-options {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 30px;
}

/* Spalvų mygtukai (kortoms, stalams ir avatarams) */
.color-btn {
    padding: 10px 20px;
    border: 3px solid transparent;
    border-radius: 10px;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.2s;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
}

.color-btn:hover {
    transform: scale(1.05);
    opacity: 0.9;
}

/* Pasirinktas variantas */
.color-btn.selected {
    border-color: var(--highlight-color);
    box-shadow: 0 0 10px var(--highlight-color);
}

/* Avatarų mygtukai */
.avatar-btn {
    width: 70px;
    height: 70px;
    padding: 0;
    border-radius: 50%;
    overflow: hidden;
}

.avatar-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
}

/* Temo keitimo mygtukas */
.theme-toggle {
    background-color: var(--btn-bg);
    color: var(--btn-text);
    padding: 12px 20px;
    border: none;
    border-radius: 8px;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.2s ease-in-out;
    margin-top: 30px;
    box-shadow: 0 4px 8px rgba(0,0,0,0.3);
}

.theme-toggle:hover {
    background-color: var(--btn-bg-hover);
    color: var(--btn-text-hover);
}

/* Konkrečios spalvos (kortoms, stalams) */
.red-btn { background-color: #c41e3a; color: #fff; }
.blue-btn { background-color: #1e6ec4; color: #fff; }
.green-btn { background-color: #38a538; color: #fff; }
.pink-btn { background-color: #e32092; color: #fff; }

.darkblue-bg { background-color: #2c425a; color: #fff; }
.green-bg { background-color: #134628; color: #fff; }
.darkred-bg { background-color: #943126; color: #fff; }
.darkpink-bg { background-color: #5c0b45; color: #fff; }
</style>
