@page "/register"
@using CardGame.Shared.Models
@inject HttpClient Http
@inject NavigationManager Nav
@inject UserSession UserSession


@code {
    private User newUser = new User();
    private string repeatPassword = "";
    private bool showErrors = false;

    // Serverio klaidos pagal laukus
    private string userNameServerError = "";
    private string emailServerError = "";

    private bool CanRegister =>
        !string.IsNullOrWhiteSpace(newUser.UserName) &&
        !string.IsNullOrWhiteSpace(newUser.Email) &&
        newUser.Email.Contains("@") &&
        !string.IsNullOrWhiteSpace(newUser.Password) &&
        newUser.Password.Length >= 6 &&
        newUser.Password == repeatPassword;

    private async Task RegisterUser()
{
    showErrors = true;
    userNameServerError = "";
    emailServerError = "";

    if (!CanRegister) return;

    var response = await Http.PostAsJsonAsync("users", newUser);

    if (response.IsSuccessStatusCode)
    {
        // gaunamas sukurtas vartotojas iš serverio
        var createdUser = await response.Content.ReadFromJsonAsync<User>();

        if (createdUser != null)
        {
            // nustatomas vartotojas Blazor sesijoje
            UserSession.SetUser(createdUser);

            Nav.NavigateTo("/start");
        }
        else
        {
            userNameServerError = "Registration succeeded but failed to load user data.";
        }
    }
    else
    {
        try
        {
            var errorJson = await response.Content.ReadFromJsonAsync<Dictionary<string, string>>();
            if (errorJson != null && errorJson.ContainsKey("field") && errorJson.ContainsKey("message"))
            {
                var field = errorJson["field"];
                var message = errorJson["message"];

                if (field.Equals("Email", StringComparison.OrdinalIgnoreCase))
                    emailServerError = message;
                else if (field.Equals("UserName", StringComparison.OrdinalIgnoreCase))
                    userNameServerError = message;
            }
            else
            {
                // Fallback, jei netikėta klaida
                userNameServerError = "Registration failed. Please try again.";
            }
        }
        catch
        {
            userNameServerError = "Unexpected server response.";
        }

        StateHasChanged();
    }
}
    // Kai vartotojas rašo į lauką, serverio klaida paslepiama
    private void OnUserNameChanged(ChangeEventArgs e)
    {
        newUser.UserName = e.Value?.ToString() ?? "";
        userNameServerError = "";
    }

    private void OnEmailChanged(ChangeEventArgs e)
    {
        newUser.Email = e.Value?.ToString() ?? "";
        emailServerError = "";
    }

    private string UserNameError =>
        !string.IsNullOrEmpty(userNameServerError) ? userNameServerError :
        (showErrors && string.IsNullOrWhiteSpace(newUser.UserName) ? "User name is required." : "");

    private string EmailError =>
        !string.IsNullOrEmpty(emailServerError) ? emailServerError :
        (showErrors && string.IsNullOrWhiteSpace(newUser.Email) ? "Email is required." :
        (showErrors && !newUser.Email.Contains("@") ? "Email must contain '@'." : ""));

    private string PasswordError =>
        showErrors && string.IsNullOrWhiteSpace(newUser.Password) ? "Password is required." :
        (showErrors && newUser.Password.Length < 6 ? "Password must be at least 6 characters." : "");

    private string RepeatPasswordError =>
        showErrors && newUser.Password != repeatPassword ? "Passwords do not match." : "";
}

<div class="index-container">

    <img src="images/durnius.png" alt="Žaidimo nuotrauka" class="top-image" />

    <div class="form-container">
        <div class="columns">
            <div class="column">
                <label class="form-label">User name</label>
                <input type="text" class="input-field" placeholder="User name"
                       value="@newUser.UserName" @oninput="OnUserNameChanged" />
                <small class="error">@UserNameError</small>

                <label class="form-label">E-mail</label>
                <input type="email" class="input-field" placeholder="E-mail"
                       value="@newUser.Email" @oninput="OnEmailChanged" />
                <small class="error">@EmailError</small>
            </div>
            <div class="column">
                <label class="form-label">Password</label>
                <input type="password" class="input-field" placeholder="Password" @bind="newUser.Password"/>
                <small class="error">@PasswordError</small>

                <label class="form-label">Repeat password</label>
                <input type="password" class="input-field" placeholder="Repeat password" @bind="repeatPassword"/>
                <small class="error">@RepeatPasswordError</small>
            </div>
        </div>

        <div class="line">
            <NavLink class="btn" href="/">Back</NavLink>
            <button class="btn" @onclick="RegisterUser">Register</button>
        </div>
    </div>

</div>

