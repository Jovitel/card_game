@page "/vs"
@layout MainLayout

<div class="page-wrapper">
    <div class="container">
        <!-- Nuotrauka ir Exit mygtukas vienoje eilutėje -->
        <div class="header">
            <img src="images/durnius.png" alt="Žaidimo nuotrauka" class="top-image" />
        </div>

        <div class="cards-row">
            <NavLink class="card-btn" href="/game/1vs1">
                <span class="card-rank">1 vs 1</span>
                <span class="card-suit">♠</span>
            </NavLink>
            <NavLink class="card-btn" href="/game/1vsmulti">
                <span class="card-rank">1 vs Multi</span>
                <span class="card-suit">♥</span>
            </NavLink>
            <NavLink class="card-btn" href="/game/1vsbot">
                <span class="card-rank">1 vs Bot</span>
                <span class="card-suit">♦</span>
            </NavLink>
            <NavLink class="card-btn" href="/game/1vsmultibots">
                <span class="card-rank">1 vs Multi Bot</span>
                <span class="card-suit">♣</span>
            </NavLink>
        </div>

        <div class="exit-wrapper">
            <NavLink class="btn exit-btn" href="/start">Exit</NavLink>
        </div>
    </div>
</div>
<style>
/* Bendras puslapio fonas */
.page-wrapper {
    background-color: var(--bg-color);
    color: var(--text-color);
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    padding: 20px;
    box-sizing: border-box;
    transition: background-color 0.3s, color 0.3s;
}

/* Konteineris */
.container {
    background-color: var(--container-bg);
    width: 98%;
    max-width: 1300px;
    min-height: 500px;
    padding: 20px;
    border-radius: 12px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.25);
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: background-color 0.3s, color 0.3s;
}

/* Viršutinė nuotrauka */
.top-image {
    width: 230px;
    height: auto;
    border-radius: 12px;
    margin-bottom: 30px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
}

/* Bendras mygtuko stilius */
.btn {
    background-color: var(--btn-bg);
    color: var(--btn-text);
    padding: 12px 24px;
    border: none;
    border-radius: 8px;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    text-align: center;
    min-width: 160px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.4);
}

.btn:hover {
    background-color: var(--btn-bg-hover);
    color: var(--btn-text-hover);
}

/* Kortų pasirinkimų eilutė */
.cards-row {
    display: flex;
    flex-direction: row;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
    margin-top: 20px;
}

/* Kiekvienos kortos (žaidimo režimo pasirinkimo) dizainas */
.card-btn {
    background-color: var(--card-bg);
    color: var(--text-color);
    border: 3px solid var(--accent-color);
    border-radius: 12px;
    cursor: pointer;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 200px;
    height: 320px;
    transition: all 0.3s ease;
    padding: 10px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.25);
}

.card-btn:hover {
    background-color: var(--hover-bg);
    transform: translateY(-5px);
    color: var(--highlight-color);
}

/* Kortų tekstas */
.card-rank {
    font-size: 20px;
    font-weight: 600;
    text-align: center;
    margin-bottom: 10px;
}

.card-suit {
    font-size: 80px;
    color: var(--text-color);
}

/* Raudonos kortos */
.card-btn.red .card-suit {
    color: var(--card-red);
}

/* Apatinė sekcija su išeities mygtuku */
.exit-wrapper {
    width: 100%;
    display: flex;
    justify-content: center;
    margin-top: 40px;
}

.exit-btn {
    min-width: 140px;
    padding: 10px 20px;
    font-size: 15px;
}
</style>
