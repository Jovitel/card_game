@page "/vs"
@layout MainLayout

<div class="page-wrapper">
    <div class="container">
        <!-- Nuotrauka ir Exit mygtukas vienoje eilutėje -->
        <div class="header">
            <img src="images/durnius.png" alt="Žaidimo nuotrauka" class="top-image" />
        </div>

        <div class="cards-row">
            <NavLink class="card-btn" href="/game/1vs1">
                <span class="card-rank">1 vs 1</span>
                <span class="card-suit">♠</span>
            </NavLink>
            <NavLink class="card-btn" href="/join">
                <span class="card-rank">1 vs Multi</span>
                <span class="card-suit">♥</span>
            </NavLink>
            <NavLink class="card-btn" href="/game/1vsbot">
                <span class="card-rank">1 vs Bot</span>
                <span class="card-suit">♦</span>
            </NavLink>
            <NavLink class="card-btn" href="/game/1vsmultibots">
                <span class="card-rank">1 vs Multi Bot</span>
                <span class="card-suit">♣</span>
            </NavLink>
        </div>

        <div class="exit-wrapper">
            <NavLink class="btn exit-btn" href="/start">Exit</NavLink>
        </div>
    </div>
</div>

<style>
.page-wrapper {
    background-color: #2c425a;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    padding: 5px;
    box-sizing: border-box;
}

.container {
    background-color: #a2c2de;
    width: 98%;
    max-width: 1300px;
    min-height: 500px;
    padding: 10px;
    border-radius: 12px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.2);
    display: flex;
    flex-direction: column;
    align-items: center;
}
.header {
    width: 100%;
    display: flex;
    justify-content: center;
    margin-bottom: 20px;
}

.exit-wrapper {
    width: 100%;
    display: flex;
    justify-content: center;
    margin-top: 20px;
}
.exit-btn {
    min-width: 120px;
    padding: 10px 20px;
    font-size: 14px;
}

.top-image {
    width: 230px;
    height: auto;
    border-radius: 12px;
}

.btn {
    background-color: #2c425a;
    color: white;
    padding: 12px;
    border: none;
    border-radius: 8px;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
    transition: 0.3s;
    text-decoration: none;
    text-align: center;
    min-width: 180px;
}

.btn:hover {
    background-color: #56708c;
    color: #f0e1b4;
}

/* Kortų eilutė */
.cards-row {
    display: flex;
    flex-direction: row;
    justify-content: center;
    gap: 20px;
   
}

/* Kortos mygtukas */
.card-btn {
    background-color: white;
    color: black;
    border: 3px solid #2c425a;
    border-radius: 12px;
    cursor: pointer;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 200px;
    height: 350px;
    transition: 0.3s;
    padding: 10px;
    position: relative;
    box-shadow: 0 4px 8px rgba(0,0,0,0.2);
}

.card-btn:hover {
    background-color: #f0f0f0;
    transform: translateY(-5px);
    color: #2867abff;
}

/* Kortos tekstas */
.card-rank {
    font-size: 20px;
    font-weight: 600;
    text-align: center;
    margin-bottom: 10px;
}

.card-suit {
    font-size: 80px;
    color: black;
}

/* Raudoni simboliai */
.card-btn:nth-child(2) .card-suit,
.card-btn:nth-child(3) .card-suit {
    color: red;
}
</style>