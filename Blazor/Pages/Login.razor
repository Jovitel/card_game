@page "/login"
@using CardGame.Shared
@using CardGame.Shared.Models
@layout MainLayout
@inject NavigationManager Nav
@inject HttpClient Http
@inject UserSession UserSession


@code {
    private string email = string.Empty;
    private string password = string.Empty;
    private bool showErrors = false;
    private string loginError = string.Empty;    

    private bool IsFormValid =>
        !string.IsNullOrWhiteSpace(email) &&
        email.Contains("@") &&
        !string.IsNullOrWhiteSpace(password) &&
        password.Length >= 6;

    private async Task PerformLogin()
    {
        showErrors = true; // klaidos pasimato tik paspaudus mygtuką

        if (!IsFormValid) return;

        var loginData = new { Email = email, Password = password };
        var response = await Http.PostAsJsonAsync("login", loginData); //kad bendrai veiktu

        if (response.IsSuccessStatusCode)
        {
            var user = await response.Content.ReadFromJsonAsync<User>();

            if (user != null)
            {
                UserSession.SetUser(user!); // Naudojame '!' operatorių
                Nav.NavigateTo("/start");
            }
            else
            {
                // Jei atsakymas sėkmingas, bet body tuščias arba neteisingas, vis tiek pranešame klaidą
                loginError = "Login failed due to server response format error.";
            }
        }
        else
        {
            loginError = "Invalid email or password.";
        }
    }

    private string EmailError =>
        showErrors && string.IsNullOrWhiteSpace(email) ? "E-mail is required." :
        (showErrors && !email.Contains("@") ? "Email must contain '@'." : "");

    private string PasswordError =>
        showErrors && string.IsNullOrWhiteSpace(password) ? "Password is required." :
        (showErrors && password.Length < 6 ? "Password must be at least 6 characters." : "");
}

<div class="index-container">

    <img src="images/durnius.png" alt="Žaidimo nuotrauka" class="top-image" />

    <div class="form-container">
        <div class="column">
            <label for="email" class="form-label">E-mail</label>
            <input type="email" @bind="email" placeholder="E-mail" class="input-field" />
            <small class="error">@EmailError</small>
        
            <label for="password" class="form-label">Password</label>
            <input type="password" @bind="password" placeholder="Password" class="input-field" />
            <small class="error">@PasswordError</small>
             @if (!string.IsNullOrEmpty(loginError))
                    {
                        <small class="error error-global">@loginError</small>
                    }
        </div>
        <div class="line">
            <NavLink class="btn" href="/">Back</NavLink>
            <button class="btn" @onclick="PerformLogin">Log in</button>
        </div>
    </div>
</div>


