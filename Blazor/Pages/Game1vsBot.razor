@page "/game/1vsbot" 
@layout MainLayout 
@using card_game.GameLogic 
@using card_game.GameDesign
@inject NavigationManager NavigationManager

<div class="page-wrapper">
    @if (game != null && humanPlayer != null && bot != null) // tik jei žaidimas ir žaidėjai yra inicializuoti
    {
        <BotDeck Bot="bot" />
        // išsaugo dabartinė žaidimo būsena
        var state = game!.State; 
        
        // nustato, ar žaidėjas gali baigti ėjimą
        var canEndTurn = game.CanEndTurn(humanPlayer);
        <h4 class="turn-info">@game.GetTurnText(humanPlayer)</h4>// rodo kieno dabar ėjimas (tekstas)
        
        // mygtukas leidžia žaidėjui baigti ėjimą, jei jis leidžiamas
        <button class="btn btn-end-turn" @onclick="EndTurn" disabled="@(!canEndTurn)">
            Baigti ėjimą
        </button>

        //<div class="card-row">
        //    @foreach (var card in bot.Hand)
        //    {
        //        // einama per visas boto kortas
        //        <div class="card-btn">@card</div>
          //      // rodomos kaip tekstas
            //}
        //</div>

        
        @if (state?.TableCards == null || state.TableCards.Count == 0) // jei ant stalo nėra kortų
        {            
        }
        else // jei kortos yra ant stalo
        {<div class="table-cards">
            @for (int i = 0; i < 6; i++)
            {
                <div class="table-pair">

                    @if (i < state.TableCards.Count)
                    {
                        var pair = state.TableCards.ElementAt(i);

                        <!-- Atakos korta (pirmoji poroje) -->
                        <GameCard Card="@pair.Key" Disabled="true" class="attack-card"/>

                        <!-- Gynybos korta, jei jau atsikirsta -->
                        @if (pair.Value != null)
                        {
                            <GameCard Card="@pair.Value" Disabled="true" class="defend-card" />
                        }
                        else
                        {
                            <div class="defend-placeholder"></div> <!-- kai dar neatsikirsta -->
                        }
                    }
        
                </div>
            }
         </div>

           // <div class="table-cards">
             //   @foreach (var pair in state.TableCards)
               // {
                    // rodoma atakos ir gynybos kortų pora
                 //   <div class="table-pair">
                   //     <div class="attack-card">Ataka: @pair.Key</div>
                     //   <div class="defend-card">
                       //     @(pair.Value != null ? $"Gynyba: {pair.Value}" : "—")
                        //</div>
                    //</div>
                //}
            //</div>
        }
        <div class="deck-wrapper">
            <DeckView 
                RemainingCardsCount="state.Deck.CardsLeft"
                TrumpCard="state.Deck.PeekBottomCard()" 
            />
        </div>


        <div class="card-row">
            @for (int i = 0; i < humanPlayer.Hand.Count; i++)
            {
                var card = humanPlayer.Hand[i];
                bool canPlay = humanPlayer.CanPlayCard(game, card);

                <div style="--index:@i; --count:@humanPlayer.Hand.Count;">
                    <GameCard Card="card"
                            Disabled="!canPlay"
                            OnPlay="PlayCard" />
                </div>
            }
        </div>
        
        <div class="player-info-bar">
            <div class="profile-placeholder"></div>
        </div>  
    }
    else // jei žaidimas dar nepradėtas
    {
        <button class="btn btn-primary" @onclick="StartGame">Pradėti žaidimą</button>
    }
</div>
     
@code {
    private bool playerWon = false;
    
    private DurakGameEngine? game;  // žaidimo variklio objektas

    private Player? humanPlayer;  // žmogaus žaidėjas

    private BotPlayer? bot;  // boto žaidėjas

    // funkcija, kuri paleidžia žaidima
    private async Task StartGame()
    {

        humanPlayer = new Player("Žaidėjas"); // sukuriamas žmogaus žaidėjas

        bot = new BotPlayer("Bot");// sukuriamas bot žaidėjas

        // sukuriamas naujas žaidimo variklis su abiem žaidėjais
        game = new DurakGameEngine(new List<Player> { humanPlayer, bot });

        await RefreshUI();  // atnaujinamas ekranas
// Toliau paleidžiama boto eilė, jei jam priklauso (galima pridėti patikrinimą)
    if (game.State.Attacker.IsBot)
    {
        await game.RunBotTurn(RefreshUI); // kviečiamas boto ėjimas, jei jam priklauso
    }
    
    await RefreshUI(); // dar kartą atnaujinti, jei botui priklausė ėjimas ir jis nebaigė žaidimo
    }

    // funkcija, kuri vykdoma kai žaidėjas paspaudžia ant kortos
    private async Task PlayCard(Card card)
    {
        // jei žaidimas arba žaidėjas neegzistuoja, funkcija nutraukiama
        if (game == null || humanPlayer == null)
            return;

        // jei žmogus yra atakuotojas
        if (game.State.Attacker == humanPlayer)
        {
            // bandoma atlikti ataką su pasirinkta korta
            if (game.Attack(humanPlayer, card))
            {
                // atnaujinamas vaizdas
                await RefreshUI();

                // trumpa pauzė
                await Task.Delay(800);

                // leidžiama botui atlikti savo ėjimą
                await game.RunBotTurn(RefreshUI);
            }
        }
        // jei žmogus yra gynėjas
        else if (game.State.Defender == humanPlayer)
        {
            // randama paskutinė atakuojanti korta ant stalo
            var attackCard = game.State.TableCards.FirstOrDefault(p => p.Value == null).Key;

            // jei galima gintis šia korta
            if (attackCard != null && game.Defend(humanPlayer, attackCard, card))
            {
                // atnaujinamas ekranas
                await RefreshUI();

                // trumpa pauzė
                await Task.Delay(800);

                // jei visos atakos yra atmuštos
                if (game.State.TableCards.All(p => p.Value != null))
                {
                    // jei atakavo botas, ėjimas užbaigiamas automatiškai
                    if (game.State.Attacker.IsBot)
                    {
                        await game.EndTurnWithDelay(false, RefreshUI);
                        await game.RunBotTurn(RefreshUI);
                    }
                    else
                    {
                        // jei atakavo žaidėjas, paliekama galimybė pridėti dar kortų
                        await RefreshUI();
                        // ėjimas nesibaigia automatiškai
                    }
                }
            }
        }

        // atnaujinamas ekranas po bet kokio veiksmo
        await RefreshUI();
    }

    // funkcija, kai žaidėjas paspaudžia mygtuką 'baigti ėjimą'
    private async Task EndTurn()
    {
        // jei žaidimas neegzistuoja, funkcija nutraukiama
        if (game == null)
            return;

        // užbaigiamas ėjimas
        await game.EndTurnWithDelay(false, RefreshUI);

        // leidžiama botui pradėti savo ėjimą
        await game.RunBotTurn(RefreshUI);
    }

    // funkcija, kuri atnaujina vartotojo sąsają
    private Task RefreshUI()
    {
        if (game?.State?.IsGameOver == true)
        {
            // 1. Nustatome, ar žaidėjas laimėjo
            playerWon = humanPlayer?.Hand.Count == 0;
            
            // 2. Iškart atliekame nukreipimą (navigaciją)
            // Galite perduoti laimėtojo informaciją per užklausos eilutę, pvz.:
            var result = playerWon ? "winner" : "loser";
            
            // Nukreipiame į pagrindinį meniu (ar kitą puslapį)
            NavigationManager.NavigateTo($"/gameover/{result}");
            
            // Grąžiname, kad toliau nereikėtų atnaujinti UI
            return Task.CompletedTask;
        }
        // pranešama Blazor, kad reikia atnaujinti vaizdą
        InvokeAsync(StateHasChanged);

        // grąžinamas užbaigtas uždavinys (be laukimo)
        return Task.CompletedTask;
    }
}

<style>
.table-cards {
    display: flex;
    justify-content: center;   /* centre visos kortos */
    gap: 40px;
    flex-wrap: nowrap;         /* visos vienoje eilutėje */
    margin-bottom: 50px;         
}
.table-pair {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
}
.attack-card {
    width: 100%;
    height: 100%;
}

.defend-card {
    position: absolute;
    top: 0;
    left: 0;
    transform: translate(30px, 35px); /* šiek tiek paslinkta */
    z-index: 10; /* kad būtų virš atakos kortos */
}


.deck-wrapper {
    position: fixed;      /* fiksuotas ekrane */
    top: 50%;             /* vertikaliai centre */
    left: 5px;           /* šiek tiek nuo kairio krašto */
    transform: translateY(-50%); /* tiksliai centras vertikaliai */
    z-index: 20;          /* virš kitų elementų */
}


.player-info-bar {
    width: 70%;                   /* užima dalį pločio */
    height: 100px;                 /* maždaug mažiau nei pusė kortos aukščio */
    background-color: #a2c2de;    /* šviesus fonas */
    border-radius: 30px;
    border: 2px solid #f0e1b4;
    display: flex;
    justify-content: flex-start;
    align-items: center;
    padding: 10px 20px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.3);
    position: relative;
}

.profile-placeholder {
    width: 50px;
    height: 50px;
    background-color: #ddd;
    border-radius: 50%;
    border: 2px solid #bbb;
}
.page-wrapper {
    background-color: #2c425a;
    min-height: 100vh;           /* kad visada būtų per visą ekraną */
    display: flex;
    flex-direction: column;      /* kad elementai būtų išdėstyti vertikaliai */
    justify-content: space-between; /* viršus–apačia tolygiai */
    align-items: center;
    padding: 20px;
    box-sizing: border-box;
}

.card-row {
    display: flex;
    justify-content: center;
    align-items: flex-end;       /* kad kortos „sėdėtų“ ant apačios */
    gap: 10px;
    flex-wrap: nowrap;
}


/
/* mygtuko „Baigti ėjimą“ stilius */
.btn-end-turn {
    margin: 20px 0;
    padding: 10px 20px;
    font-weight: bold;
    background-color: #2c425a;
    color: white;
    border-radius: 8px;
    border: none;
    cursor: pointer;
}

/* išjungtas „Baigti ėjimą“ mygtukas */
.btn-end-turn:disabled {
    background-color: #888;
    cursor: not-allowed;
}

/* informacijos apie ėjimą stilius */
.turn-info {
    font-size: 18px;
    font-weight: bold;
    margin: 10px 0;
    padding: 10px;
    border-radius: 8px;
    background-color: #f2f2f2;
}
</style>
