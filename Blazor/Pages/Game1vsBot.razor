@page "/game/1vsbot"
@layout MainLayout
@using card_game.GameLogic
@using card_game.GameDesign
@using CardGame.Shared.Models
@using card_game.Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject UserSession UserSession
@inject UserSession Session
@inject CardSettingsService CardSettingsService
@implements IDisposable

<div class="page-wrapper" style="background-color: @CardSettingsService.SelectedTableColor;">
    @if (game != null && humanPlayer != null && bot != null)
    {
        <!-- BOT viršuje -->
        <div class="multi-opponents">
            <div class="opponent-block">
                <div class="opponent-info-bar">
                    <img src="images/bot.png" alt="Bot Avatar" class="opponent-avatar" />
                    <span class="opponent-label">@bot!.Name</span>
                </div>
                <div class="opponent-hand-small">
                    @for (int i = 0; i < bot.Hand.Count; i++)
                    {
                        <div class="card-small">
                            <BackCard />
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Kaladė ir eilės tekstas -->
        <div class="deck-wrapper">
            <DeckView RemainingCardsCount="game.State.Deck.CardsLeft" TrumpCard="game.State.Deck.TrumpCard" />
            <div class="turn-info">@game.GetTurnText(humanPlayer)</div>
        </div>

        <!-- Mygtukai -->
        <div class="turn-buttons">
            <button class="btn btn-end-turn" @onclick="EndTurn"
                disabled="@(!game.CanEndTurn(humanPlayer) || game.State.IsGameOver)">
                Baigti ėjimą
            </button>

            <button class="btn btn-warning" @onclick="PickUpCards"
                disabled="@(game.State.Defender != humanPlayer || game.State.TableCards.Count == 0)">
                Paimti kortas
            </button>
        </div>

        <!-- Kortos ant stalo -->
        <div class="table-cards">
            @if (game.State.TableCards != null && game.State.TableCards.Count > 0)
            {
                var tableSnapshot = game.State.TableCards.ToList();
                @for (int i = 0; i < 6; i++)
                {
                    <div class="table-pair">
                        @if (i < tableSnapshot.Count)
                        {
                            var pair = tableSnapshot[i];
                            <GameCard Card="@pair.Key" Disabled="true" class="attack-card" />
                            @if (pair.Value != null)
                            {
                                <GameCard Card="@pair.Value" Disabled="true" class="defend-card" />
                            }
                            else
                            {
                                <div class="defend-placeholder"></div>
                            }
                        }
                    </div>
                }
            }
        </div>

        <!-- Žaidėjo ranka -->
        @if (humanPlayer?.Hand != null)
        {
            <div class="card-row player-hand">
                @for (int i = 0; i < humanPlayer.Hand.Count; i++)
                {
                    var card = humanPlayer.Hand[i];
                    bool canPlay =
                    ((game.State.Attacker == humanPlayer && game.CanAttackWith(humanPlayer, card)) ||
                    (game.State.Defender == humanPlayer && game.CanDefendWith(humanPlayer, card)));

                    <div class="@(canPlay ? "" : "tooltip-container")" data-tooltip="@(canPlay ? "" : "Negalima naudoti kortos")"
                        style="--index:@i; --count:@humanPlayer.Hand.Count;">
                        <GameCard Card="card" Disabled="!canPlay" OnPlay="() => PlayCard(card)" />
                    </div>
                }
            </div>
        }

        <!-- Žaidėjo info -->
        <div class="player-info-bar">
            <img src="@Session.SelectedAvatarUrl" alt="Mano Avataras" class="player-avatar-small" />
            <span class="opponent-label" style="margin-left:10px;">
                @(UserSession?.Username ?? humanPlayer?.Name ?? "Žaidėjas")
            </span>

        </div>
    }
    else
    {
        <button class="btn btn-primary" @onclick="StartGame">Pradėti žaidimą</button>
    }
</div>


@code {
    private DurakGameEngine? game;
    private Player? humanPlayer;
    private BotPlayer? bot;
    private bool statsSent = false;
    private bool playerWon = false;

    // Turime prenumeruoti įvykį OnChange, kad persikrautų pasikeitus stalo spalvai
    protected override void OnInitialized()
    {
        // Prenumeruojame paslaugos pokyčius, kad atnaujintume UI keičiantis stalo spalvai
        CardSettingsService.OnChange += StateHasChanged;
    }
    protected override async Task OnInitializedAsync()
    {
        // Pirmiausia patikriname, ar vartotojas prisijungęs.
        if (UserSession.CurrentUser == null || UserSession.UserId <= 0)
        {
        }
        else 
        {
            // 1. Įkeliame Kortų Nugarėlės Spalvą
            CardSettingsService.SetCardColor(UserSession.CurrentUser.SelectedCardColor);
            
            // 2. Įkeliame Stalo Fono Spalvą
            CardSettingsService.SetTableColor(UserSession.CurrentUser.SelectedTableColor);
        }
    }
    // PRIVALOMA: Įgyvendinamas Dispose metodas, kad atšauktume prenumeratą
    public void Dispose()
    {
        CardSettingsService.OnChange -= StateHasChanged;
    }
    private async Task StartGame()
    {
        humanPlayer = new Player("Žaidėjas");
        bot = new BotPlayer("Bot");
        game = new DurakGameEngine(new List<Player> { humanPlayer, bot });

        Console.WriteLine("[INFO] Žaidimas pradėtas (1vsBot)");
        await RefreshUI();

        if (game.State.Attacker.IsBot)
        {
            Console.WriteLine("[DEBUG] Pirmas ėjimas priklauso botui.");
            await game.RunBotTurn(RefreshUI);
        }
    }

    private async Task PlayCard(Card card)
    {
        if (game == null || humanPlayer == null)
            return;

        Console.WriteLine($"[DEBUG] Žaidėjas bando sužaisti {card}");

        // ataka
        if (game.State.Attacker == humanPlayer)
        {
            if (game.Attack(humanPlayer, card))
            {
                UserSession.AddGameHistoryEntry(
                turnNumber: game.State.TurnNumber,
                player: humanPlayer.Name,
                action: "ATTACK",
                cardPlayed: card
                );
                Console.WriteLine($"[ACTION] {humanPlayer.Name} atakavo su {card}");
                await RefreshUI();
                await Task.Delay(800);
                await game.RunBotTurn(RefreshUI);
            }
        }
        // gynyba
        else if (game.State.Defender == humanPlayer)
        {
            var attackCard = game.State.TableCards.FirstOrDefault(p => p.Value == null).Key;

            if (attackCard != null && game.Defend(humanPlayer, attackCard, card))
            {
                UserSession.AddGameHistoryEntry(
                turnNumber: game.State.TurnNumber,
                player: humanPlayer.Name,
                action: "DEFEND",
                cardPlayed: card,
                attackCard: attackCard
                );

                Console.WriteLine($"[ACTION] {humanPlayer.Name} ginasi su {card} nuo {attackCard}");

                await RefreshUI();
                await Task.Delay(800);

                if (game.State.TableCards.All(p => p.Value != null))
                {
                    Console.WriteLine("[DEBUG] Visos atakos atmuštos, baigiamas ėjimas.");
                    await game.EndTurnWithDelay(false, RefreshUI);
                    await game.RunBotTurn(RefreshUI);
                }
            }
            else
            {
                Console.WriteLine($"[WARN] Negalima gintis su {card}");
            }
        }

        await RefreshUI();
    }

    private async Task PickUpCards()
    {
        if (game == null || humanPlayer == null)
            return;
        if (game.State.Defender != humanPlayer)
            return;

        Console.WriteLine("[INFO] Žaidėjas pasirinko „Paimti kortas“.");

        foreach (var pair in game.State.TableCards)
        {
            humanPlayer.Hand.Add(pair.Key);
            if (pair.Value != null)
                humanPlayer.Hand.Add(pair.Value);
        }

        UserSession.AddGameHistoryEntry(
        turnNumber: game.State.TurnNumber,
        player: humanPlayer.Name,
        action: "PICKUP"
                );

        game.State.TableCards.Clear();
        await game.EndTurnWithDelay(true, RefreshUI);
        await game.RunBotTurn(RefreshUI);
    }

    private async Task EndTurn()
    {
        if (game == null) return;

        Console.WriteLine("[INFO] Žaidėjas baigia ėjimą.");

        UserSession.AddGameHistoryEntry(
        turnNumber: game.State.TurnNumber,
        player: game.State.Attacker.Name,
        action: "ENDTURN"
                );

        await game.EndTurnWithDelay(false, RefreshUI);
        await game.RunBotTurn(RefreshUI);
    }

    private async Task RefreshUI()
    {
        if (game?.State?.IsGameOver == true && !statsSent)
        {
            statsSent = true;
            playerWon = (humanPlayer?.Hand?.Count ?? 1) == 0;
            var result = playerWon ? "winner" : "loser";

            Console.WriteLine($"Game over. PlayerWon: {playerWon}");

            if (UserSession.UserId > 0)
            {
                HttpResponseMessage response;
                if (playerWon)
                {
                    response = await Http.PostAsync($"api/stats/win/{UserSession.UserId}", null);
                    await Http.PostAsync($"api/users/addxp/{UserSession.UserId}/50", null); // Pvz. 50 XP už laimėjimą prieš botą


                    Console.WriteLine($"POST win status: {response.StatusCode}");
                }
                else
                {
                    response = await Http.PostAsync($"api/stats/loss/{UserSession.UserId}", null);
                    Console.WriteLine($"POST loss status: {response.StatusCode}");
                }
                var refreshedUser = await Http.GetFromJsonAsync<User>($"api/users/{UserSession.UserId}");
                if (refreshedUser != null)
                {
                    UserSession.SetUser(refreshedUser);
                    Console.WriteLine($"Updated Wins: {refreshedUser.Wins}, Losses: {refreshedUser.Losses}, XP: {refreshedUser.ExperiencePoints}, Level: {refreshedUser.Level}");
                }

            }

            NavigationManager.NavigateTo($"/gameover/{result}");
            await InvokeAsync(StateHasChanged);
            return;
        }

        await InvokeAsync(StateHasChanged);
    }
}


<style>
    .page-wrapper {
        background-color: var(--bg-color);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        box-sizing: border-box;
        padding: 20px;
    }

    .multi-opponents {
        position: fixed;
        top: 10px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        justify-content: center;
        align-items: flex-start;
        gap: 120px;
        width: 100%;
        z-index: 10;
    }

    .opponent-hand-small {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        gap: 4px;
        transform: scale(0.85);
    }

    .opponent-info-bar {
        background-color: #a2c2de;
        border: 2px solid #f0e1b4;
        border-radius: 15px;
        width: 200px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }

    .opponent-label {
        color: #1c2d3e;
        font-size: 13px;
        font-weight: 600;
    }

    .card-small {
        width: 40px;
        height: 62px;
    }

    .table-cards {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        gap: 45px;
        margin-top: 200px;
        /* BUVO 200px – dabar aukščiau */
        margin-bottom: 140px;
        /* didesnis tarpas iki žaidėjo kortų */
    }

    .table-pair {
        position: relative;
        width: 110px;
        height: 160px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .attack-card {
        width: 100px;
        height: 150px;
    }

    .defend-card {
        position: absolute;
        top: 40px;
        left: 25px;
    }

    .player-hand {
        position: fixed;
        bottom: 90px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        justify-content: center;
        gap: 0;
    }

    /* --- mygtukai --- */
    .turn-buttons {
        position: fixed;
        right: 30px;
        bottom: 100px;
        display: flex;
        flex-direction: column;
        gap: 12px;
        z-index: 20;
    }

    /* --- Vieningas mygtukų stilius --- */
    .turn-buttons button {
        padding: 12px 24px;
        font-weight: 600;
        font-size: 16px;
        border-radius: 10px;
        border: none;
        cursor: pointer;
        transition: all 0.2s ease-in-out;
        color: #fff;
        background-color: #3a5a8c;
        /* tamsiai mėlynas tonas */
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.25);
    }

    /* --- Hover efektas (aktyvus) --- */
    .turn-buttons button:hover:not(:disabled) {
        background-color: #507bc0;
        /* šviesesnis mėlynas */
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
        color: #f0e1b4;
    }

    /* --- Paspaudimo efektas --- */
    .turn-buttons button:active:not(:disabled) {
        transform: translateY(0);
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.25);
    }

    /* --- Neaktyvūs (disabled) --- */
    .turn-buttons button:disabled {
        background-color: #5f728f;
        color: #dcdcdc;
        cursor: not-allowed;
        opacity: 0.7;
        box-shadow: none;
    }

    /* --- Jei nori išlaikyti simbolinį skirtumą tarp dviejų mygtukų --- */
    .btn-end-turn {
        background-color: #3a5a8c;
        /* mėlynas */
    }

    .btn-warning {
        background-color: #d37b2a;
        /* oranžinis variantas */
    }

    .btn-warning:hover:not(:disabled) {
        background-color: #e0913e;
    }


    .turn-info {
        color: #f0e1b4;
        font-size: 18px;
        font-weight: 500;
        text-align: center;
        margin-top: 6px;
    }

    .player-info-bar {
        position: fixed;
        bottom: 5px;
        left: 50%;
        transform: translateX(-50%);
        width: 55%;
        height: 50px;
        background-color: #a2c2de;
        border-radius: 20px;
        border: 2px solid #f0e1b4;
        display: flex;
        align-items: center;
        justify-content: flex-start;
        padding: 8px 16px;
    }

    .profile-placeholder {
        width: 40px;
        height: 40px;
        background-color: #ddd;
        border-radius: 50%;
        border: 2px solid #bbb;
    }

    .tooltip-container {
        position: relative;
        cursor: not-allowed;
    }

    .deck-wrapper {
        position: fixed;
        top: 45%;
        /* šiek tiek aukščiau, kad būtų per vidurį */
        left: 40px;
        /* kairėje pusėje ekrano */
        transform: translateY(-50%);
        display: flex;
        flex-direction: column;
        /* leidžia info tekstą dėti po kalade */
        align-items: center;
        gap: 8px;
        /* tarpas tarp kaladės ir teksto */
        z-index: 20;
    }

    .tooltip-container[data-tooltip]:hover::after {
        content: attr(data-tooltip);
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        white-space: nowrap;
        background-color: #56708c;
        color: #f0e1b4;
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 13px;
        z-index: 100;
        margin-bottom: 9px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.2);
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.2s ease, visibility 0.2s ease;
    }

    .tooltip-container[data-tooltip]:hover::after {
        opacity: 1;
        visibility: visible;
    }

    .player-avatar-small {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        border: 2px solid #bbb;
        object-fit: cover;
    }

    .opponent-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: 2px solid #bbb;
        object-fit: cover;
    }
</style>