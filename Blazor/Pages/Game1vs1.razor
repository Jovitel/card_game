@page "/game/1vs1"
@page "/game/1vs1/{JoinCode?}"
@layout MainLayout
@using card_game.GameLogic
@using card_game.Services
@using card_game.GameDesign
@using CardGame.Shared.Models
@using System.Text.Json
@inject GameClientService GameClient
@inject HttpClient Http
@inject UserSession UserSession
@inject NavigationManager NavigationManager

<h3>Durak 1vs1 Online</h3>

@if (!connected)
{
    <p>Jungiamasi prie serverio...</p>
}
else if (!engineReady)
{
    <p>Laukiama kito žaidėjo... Kodas: <b>@roomCode</b></p>
}
else
{
    <h4>@turnText</h4>

    <div class="top-hand">
        <div class="card-row">
            @foreach (var card in opponent!.Hand)
            {
                <GameCard Card="card" Disabled="true" />
            }
        </div>
    </div>

    <div class="table-area">
        @foreach (var pair in game!.State.TableCards)
        {
            <div class="card-pair">
                <GameCard Card="@pair.Key" Disabled="true" />
                @if (pair.Value != null)
                {
                    <GameCard Card="@pair.Value" Disabled="true" />
                }
                else
                {
                    <div class="defend-placeholder">•••</div>
                }
            </div>
        }
    </div>

    <div class="bottom-hand">
        <div class="card-row">
            @foreach (var card in me!.Hand)
            {
                bool canPlay =
                    myTurn &&
                    ((game!.State.Attacker == me && game.CanAttackWith(me, card)) ||
                    (game.State.Defender == me && game.CanDefendWith(me, card)));

                <GameCard Card="card" Disabled="!canPlay" OnPlay="() => PlayCard(card)" />
            }
        </div>
    </div>

    <button class="btn btn-primary" @onclick="EndTurn" disabled="@(!myTurn)">
        Baigti ėjimą
    </button>
    <button class="btn btn-warning" @onclick="PickUpCards" disabled="@(!myTurn || game?.State.Defender != me)">
    Paimti kortas
</button>
}

@code {
    [Parameter] public string? JoinCode { get; set; }

    private DurakGameEngine? game;
    private Player? me;
    private Player? opponent;

    private string? roomCode;
    private bool connected = false;
    private bool engineReady = false;
    private bool myTurn = false;
    private string turnText = "";
    private bool statsSent = false;

    private bool isHost => string.IsNullOrEmpty(JoinCode);

    protected override async Task OnInitializedAsync()
    {
        GameClient.OnStartGame += HostStartGame;
        GameClient.OnGameActionReceived += ApplyAction;

        await GameClient.ConnectAsync();
        connected = true;

        if (isHost)
        {
            roomCode = GenerateRoomCode();
            await GameClient.CreateRoomAsync(roomCode);
        }
        else
        {
            roomCode = JoinCode;
            await GameClient.JoinRoomAsync(roomCode!);
        }

        await InvokeAsync(StateHasChanged);
    }

    private async void HostStartGame()
    {
        if (!isHost) return;

        me = new Player("P1");
        opponent = new Player("P2");

        game = new DurakGameEngine(new List<Player> { me, opponent });

        SendInitState();
        await SetupTurnsAsync();

        engineReady = true;
        UpdateTurnText();
        await InvokeAsync(StateHasChanged);
    }

    private async void SendInitState()
    {
        var initAction = new GameAction
        {
            Action = "INIT",
            Data =
            {
                ["trump"] = game!.State.TrumpSuit.ToString(),
                ["p1cards"] = JsonSerializer.Serialize(me!.Hand),
                ["p2cards"] = JsonSerializer.Serialize(opponent!.Hand)
            }
        };

        await GameClient.SendGameActionAsync(initAction);
    }

    private void ApplyInit(GameAction a)
    {
        if (isHost || engineReady) return;

        me = new Player("P2");
        opponent = new Player("P1");
        game = new DurakGameEngine(new List<Player> { opponent!, me! });

        // hosto duomenys
        opponent!.Hand = JsonSerializer.Deserialize<List<Card>>(a.Data["p1cards"])!;
        me!.Hand = JsonSerializer.Deserialize<List<Card>>(a.Data["p2cards"])!;
        game.State.TrumpSuit = Enum.Parse<Suit>(a.Data["trump"]);

        // išjungiam kaladės naudojimą šiame kliente
        game.State.Deck = new Deck();
        game.State.Deck = new Deck(); // dummy deck, guest pusėje nenaudojamas


        engineReady = true;
        UpdateTurnText();
        InvokeAsync(StateHasChanged);
    }

    private async Task SetupTurnsAsync()
    {
        var rand = new Random();
        bool hostStarts = rand.Next(2) == 0;
        string starterTag = hostStarts ? "P1" : "P2";

        ForceStarter(starterTag);
        myTurn = hostStarts;

        var turnAction = new GameAction
        {
            Action = "SETTURN",
            Data =
            {
                ["myTurn"] = (!hostStarts).ToString(),
                ["starter"] = starterTag
            }
        };

        await GameClient.SendGameActionAsync(turnAction);
        UpdateTurnText();
    }

    private void ForceStarter(string starterTag)
    {
        Player starter = starterTag == "P1"
            ? (isHost ? me : opponent)!
            : (isHost ? opponent : me)!;

        var idx = game!.State.Players.IndexOf(starter);
        game.State.CurrentAttackerIndex = idx;
        game.State.CurrentDefenderIndex = (idx + 1) % game.State.Players.Count;
        game.State.Attacker = game.State.Players[game.State.CurrentAttackerIndex];
        game.State.Defender = game.State.Players[game.State.CurrentDefenderIndex];
    }

    private async Task PlayCard(Card card)
    {
        if (!myTurn || game == null || me == null) return;

        // DEFEND
        if (game.State.Defender == me)
        {
            var attackCard = game.State.TableCards.FirstOrDefault(p => p.Value == null).Key;
            if (attackCard != null && game.Defend(me!, attackCard, card))
            {
                myTurn = false;
                UpdateTurnText();

                var act = new GameAction
                {
                    Action = "DEFEND",
                    Data =
                    {
                        ["attackSuit"] = attackCard.Suit.ToString(),
                        ["attackValue"] = attackCard.Value.ToString(),
                        ["suit"] = card.Suit.ToString(),
                        ["value"] = card.Value.ToString()
                    }
                };

                await GameClient.SendGameActionAsync(act);
                await InvokeAsync(StateHasChanged);
                return;
            }
        }

        // ATTACK
        if (game.Attack(me!, card))
        {
            myTurn = false;
            UpdateTurnText();

            var action = new GameAction
            {
                Action = "ATTACK",
                Data =
                {
                    ["suit"] = card.Suit.ToString(),
                    ["value"] = card.Value.ToString()
                }
            };
            await GameClient.SendGameActionAsync(action);
            await InvokeAsync(StateHasChanged);
        }
    }

private async Task PickUpCards()
{
    if (game == null || me == null) return;
    if (!myTurn) return;
    if (game.State.Defender != me) return;

    // Paimam visas kortas nuo stalo
    foreach (var pair in game.State.TableCards)
    {
        me.Hand.Add(pair.Key);
        if (pair.Value != null)
            me.Hand.Add(pair.Value);
    }

    game.State.TableCards.Clear();

    if (isHost)
    {
        game.EndTurn(true);

        var act = new GameAction
        {
            Action = "PICKUP",
            Data =
            {
                ["p1cards"] = JsonSerializer.Serialize(game.State.Players[0].Hand),
                ["p2cards"] = JsonSerializer.Serialize(game.State.Players[1].Hand),
                ["nextAttacker"] = game.State.Attacker.Name,
                ["nextDefender"] = game.State.Defender.Name,
                ["trump"] = game.State.TrumpSuit.ToString()
            }
        };

        await GameClient.SendGameActionAsync(act);

        //Iškart atnaujiname vietinį UI (kad nesulauktume SignalR round-trip)
        ApplyAction(act);
    }
    else
    {
        // Guest prašo hosto patvirtinti pickup
        var request = new GameAction { Action = "REQUEST_PICKUP" };
        await GameClient.SendGameActionAsync(request);
    }

    myTurn = false;
    UpdateTurnText();
    await InvokeAsync(StateHasChanged);
}


private async Task EndTurn()
{
    if (!myTurn || game == null || me == null) return;
    if (!game.CanEndTurn(me!)) return;

    if (isHost)
    {
        // Hostas turi tikrą kaladę, todėl čia išdalina kortas
        game.EndTurn(false);

        // siunčiam viską abiem pusėm
        var act = new GameAction
        {
            Action = "ENDTURN",
            Data =
            {
                ["nextAttacker"] = game.State.Attacker.Name,
                ["nextDefender"] = game.State.Defender.Name,
                ["p1cards"] = JsonSerializer.Serialize(game.State.Players[0].Hand),
                ["p2cards"] = JsonSerializer.Serialize(game.State.Players[1].Hand),
                ["trump"] = game.State.TrumpSuit.ToString()
            }
        };

        await GameClient.SendGameActionAsync(act);
    }
    else
    {
        // Guest neturi deck – tik prašo hosto užbaigti ėjimą
        var request = new GameAction { Action = "REQUEST_ENDTURN" };
        await GameClient.SendGameActionAsync(request);
    }

    myTurn = false;
    UpdateTurnText();
    await InvokeAsync(StateHasChanged);
}


private async void ApplyAction(GameAction action)
{
    switch (action.Action)
    {
        case "INIT":
            ApplyInit(action);
            break;

        case "SETTURN":
            if (!isHost)
                myTurn = bool.Parse(action.Data["myTurn"]);
            if (action.Data.TryGetValue("starter", out var starterTag))
                ForceStarter(starterTag);
            break;

        case "ATTACK":
            HandleRemoteAttack(action);
            break;

        case "DEFEND":
            HandleRemoteDefend(action);
            break;

        case "REQUEST_ENDTURN":
            if (isHost && game != null)
            {
                game.EndTurn(false);

                var act = new GameAction
                {
                    Action = "ENDTURN",
                    Data =
                    {
                        ["nextAttacker"] = game.State.Attacker.Name,
                        ["nextDefender"] = game.State.Defender.Name,
                        ["p1cards"] = JsonSerializer.Serialize(game.State.Players[0].Hand),
                        ["p2cards"] = JsonSerializer.Serialize(game.State.Players[1].Hand),
                        ["trump"] = game.State.TrumpSuit.ToString()
                    }
                };
                await GameClient.SendGameActionAsync(act);
            }
            break;

        case "ENDTURN":
        {
            if (action.Data.TryGetValue("nextAttacker", out var attName) &&
                action.Data.TryGetValue("nextDefender", out var defName))
            {
                var att = game!.State.Players.FirstOrDefault(p => p.Name == attName);
                var def = game.State.Players.FirstOrDefault(p => p.Name == defName);
                if (att != null && def != null)
                {
                    game.State.Attacker = att;
                    game.State.Defender = def;
                    game.State.CurrentAttackerIndex = game.State.Players.IndexOf(att);
                    game.State.CurrentDefenderIndex = game.State.Players.IndexOf(def);
                }
            }

            if (action.Data.TryGetValue("p1cards", out var p1json) &&
                action.Data.TryGetValue("p2cards", out var p2json))
            {
                var p1Cards = JsonSerializer.Deserialize<List<Card>>(p1json)!;
                var p2Cards = JsonSerializer.Deserialize<List<Card>>(p2json)!;

                var p1 = game!.State.Players.First(p => p.Name == "P1");
                var p2 = game.State.Players.First(p => p.Name == "P2");

                p1.Hand = p1Cards;
                p2.Hand = p2Cards;
            }

            if (action.Data.TryGetValue("trump", out var trumpSuit))
                game!.State.TrumpSuit = Enum.Parse<Suit>(trumpSuit);

            game!.State.TableCards.Clear();
            myTurn = (game!.State.Attacker == me);
            break;
        }
        case "REQUEST_PICKUP":
    if (isHost && game != null)
    {
        // Hostas atlieka pickup logiką
        var defender = game.State.Defender;
        foreach (var pair in game.State.TableCards)
        {
            defender.Hand.Add(pair.Key);
            if (pair.Value != null)
                defender.Hand.Add(pair.Value);
        }

        game.EndTurn(true);

        var act = new GameAction
        {
            Action = "PICKUP",
            Data =
            {
                ["p1cards"] = JsonSerializer.Serialize(game.State.Players[0].Hand),
                ["p2cards"] = JsonSerializer.Serialize(game.State.Players[1].Hand),
                ["nextAttacker"] = game.State.Attacker.Name,
                ["nextDefender"] = game.State.Defender.Name,
                ["trump"] = game.State.TrumpSuit.ToString()
            }
        };

        await GameClient.SendGameActionAsync(act);
    }
    break;

    case "PICKUP":
{
    // atnaujinam žaidimo būseną
    var p1 = game!.State.Players.First(p => p.Name == "P1");
    var p2 = game.State.Players.First(p => p.Name == "P2");

    p1.Hand = JsonSerializer.Deserialize<List<Card>>(action.Data["p1cards"])!;
    p2.Hand = JsonSerializer.Deserialize<List<Card>>(action.Data["p2cards"])!;
    game.State.TableCards.Clear();

    // iš JSON ateina kas yra atakuotojas/gynėjas vardais
    var attName = action.Data["nextAttacker"];
    var defName = action.Data["nextDefender"];

    var att = game.State.Players.First(p => p.Name == attName);
    var def = game.State.Players.First(p => p.Name == defName);
    game.State.Attacker = att;
    game.State.Defender = def;
    game.State.CurrentAttackerIndex = game.State.Players.IndexOf(att);
    game.State.CurrentDefenderIndex = game.State.Players.IndexOf(def);

    //Nustatom kieno eilė
    // jei dabar aš esu atakuotojas – tai mano ėjimas
    myTurn = (game.State.Attacker == me) || (game.State.Defender == me && game.State.TableCards.Count == 0);
    UpdateTurnText();

    await InvokeAsync(StateHasChanged);
    break;
}


    }

    //BENDRAS UI atnaujinimas – turi būti po viso switch
    UpdateTurnText();
    await InvokeAsync(StateHasChanged);
}



    private void HandleRemoteAttack(GameAction action)
    {
        var suit = Enum.Parse<Suit>(action.Data["suit"]);
        var val = int.Parse(action.Data["value"]);
        var card = opponent!.Hand.FirstOrDefault(c => c.Suit == suit && c.Value == val);
        if (card != null)
            game!.Attack(opponent!, card);

        myTurn = (game!.State.Defender == me);
    }

    private void HandleRemoteDefend(GameAction action)
    {
        var asuit = Enum.Parse<Suit>(action.Data["attackSuit"]);
        var aval = int.Parse(action.Data["attackValue"]);
        var dsuit = Enum.Parse<Suit>(action.Data["suit"]);
        var dval = int.Parse(action.Data["value"]);

        var atkCard = game!.State.TableCards.Keys.FirstOrDefault(c => c.Suit == asuit && c.Value == aval);
        if (atkCard == null) return;

        var defCard = opponent!.Hand.FirstOrDefault(c => c.Suit == dsuit && c.Value == dval);
        if (defCard == null) return;

        if (!game.Defend(opponent!, atkCard, defCard)) return;

        myTurn = (game!.State.Attacker == me);
    }

    private void UpdateTurnText()
    {
        if (game == null || me == null)
        {
            turnText = "";
            return;
        }
        turnText = game.GetTurnText(me);
    }

    private Random rnd = new();
    private string GenerateRoomCode(int length = 6)
    {
        const string chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
        return new string(Enumerable.Repeat(chars, length)
            .Select(s => s[rnd.Next(s.Length)]).ToArray());
    }

    private async Task RefreshUI()
    {
        if (game?.State?.IsGameOver == true && !statsSent)
        {
            statsSent = true;
            bool playerWon = me!.Hand.Count == 0;
            var result = playerWon ? "winner" : "loser";

            Console.WriteLine($"Game over. PlayerWon: {playerWon}");

            if (UserSession.UserId > 0)
            {
                HttpResponseMessage response;
                if (playerWon)
                {
                    response = await Http.PostAsync($"api/stats/win/{UserSession.UserId}", null);
                    Console.WriteLine($"POST win status: {response.StatusCode}");
                }
                else
                {
                    response = await Http.PostAsync($"api/stats/loss/{UserSession.UserId}", null);
                    Console.WriteLine($"POST loss status: {response.StatusCode}");
                }

                var updatedUser = await Http.GetFromJsonAsync<User>($"api/users/{UserSession.UserId}");
                if (updatedUser != null)
                {
                    UserSession.SetUser(updatedUser);
                    Console.WriteLine($"Updated Wins: {updatedUser.Wins}, Losses: {updatedUser.Losses}");
                }
            }

            NavigationManager.NavigateTo($"/gameover/{result}");
            await InvokeAsync(StateHasChanged);
            return;
        }

        await InvokeAsync(StateHasChanged);
    }
}

<style>
.card-row { display:flex; justify-content:center; gap:8px; margin:10px; }
.table-area { display:flex; justify-content:center; gap:50px; margin:25px; }
.card-pair { display:flex; flex-direction:column; align-items:center; }
.top-hand, .bottom-hand { margin:15px; text-align:center; }
.defend-placeholder { width:60px; height:80px; display:flex; align-items:center; justify-content:center; color:#fff;}
</style>
