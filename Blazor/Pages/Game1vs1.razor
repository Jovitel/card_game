@page "/game/1vs1"
@page "/game/1vs1/{JoinCode?}"
@layout MainLayout
@using card_game.GameLogic
@using card_game.GameDesign
@using card_game.Services
@using CardGame.Shared.Models
@using System.Text.Json
@inject GameClientService GameClient
@inject HttpClient Http
@inject UserSession UserSession
@inject UserSession Session
@inject NavigationManager NavigationManager
@inject UserSession UserSession
@inject CardSettingsService CardSettingsService
@implements IDisposable

<div class="page-wrapper" style="background-color: @CardSettingsService.SelectedTableColor;">
    @if (!connected)
    {
        <p>Jungiamasi prie serverio...</p>
    }
    else if (!engineReady || game == null || me == null || opponent == null)
    {
        <div class="waiting-container">
            <p class="waiting-text">Laukiama kito žaidėjo...</p>
            <p class="join-code-label">Kodas:</p>
            <p class="join-code">@roomCode</p>
        </div>
    }
    else
    {
        <!-- Viršuje: oponentas -->
        <div class="multi-opponents">
            <div class="opponent-block">
                <div class="opponent-info-bar">
                    <img src="@opponentAvatarUrl" alt="Oponento Avataras" class="opponent-avatar" />
                    <span class="opponent-label">@opponent!.Name</span>
                </div>

                <div class="opponent-hand-small">
                    @for (int i = 0; i < opponent!.Hand.Count; i++)
                    {
                        <div class="card-small">
                            <BackCard />
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Mygtukai -->
        <div class="turn-buttons">
            <button class="btn btn-end-turn" @onclick="EndTurn"
                disabled="@(!myTurn || !game.CanEndTurn(me) || game.State.IsGameOver)">
                Baigti ėjimą
            </button>

            <button class="btn btn-warning" @onclick="PickUpCards"
                disabled="@(!myTurn || game?.State.Defender != me || me.Hand.Count == 0)">
                Paimti kortas
            </button>
        </div>

        <div class="chat-container-wrapper">
            <ChatWindow />
        </div>

        <!-- Kortos ant stalo -->
        <div class="table-cards">
            @if (game?.State?.TableCards != null && game.State.TableCards.Count > 0)
            {
                var tableSnapshot = game.State.TableCards.ToList();

                @for (int i = 0; i < 6; i++)
                {
                    <div class="table-pair">
                        @if (i < tableSnapshot.Count)
                        {
                            var pair = tableSnapshot[i];
                            <GameCard Card="@pair.Key" Disabled="true" class="attack-card" />
                            @if (pair.Value != null)
                            {
                                <GameCard Card="@pair.Value" Disabled="true" class="defend-card" />
                            }
                            else
                            {
                                <div class="defend-placeholder"></div>
                            }
                        }
                    </div>
                }
            }
        </div>

        <!-- Kaladė + eilės info -->
        <div class="deck-wrapper">
            <DeckView @key="game?.State?.Deck?.CardsLeft" RemainingCardsCount="game?.State?.Deck?.CardsLeft ?? 0"
                TrumpCard="game?.State?.Deck?.TrumpCard" />

            <h4 class="turn-info">@turnText</h4>
        </div>

        <!-- Žaidėjo ranka -->
        @if (me?.Hand != null && game?.State != null)
        {
            <div class="card-row player-hand">
                @for (int i = 0; i < me.Hand.Count; i++)
                {
                    var card = me.Hand[i];
                    bool canPlay =
                    myTurn &&
                    (((game?.State?.Attacker == me) && game?.CanAttackWith(me, card) == true) ||
                    ((game?.State?.Defender == me) && game?.CanDefendWith(me, card) == true));

                    <div class="@(canPlay ? "" : "tooltip-container")" data-tooltip="@(canPlay ? "" : "Negalima naudoti kortos")"
                        style="--index:@i; --count:@me.Hand.Count;">
                        <GameCard Card="card" Disabled="!canPlay" OnPlay="() => PlayCard(card)" />
                    </div>
                }
            </div>
        }


        <!-- Žaidėjo info -->
        <div class="player-info-bar">
            <img src="@Session.SelectedAvatarUrl" alt="Mano Avataras" class="player-avatar-small" />
            <span class="opponent-label" style="margin-left:10px;">@me?.Name</span>
        </div>
    }
</div>


@code {
    [Parameter] public string? JoinCode { get; set; }

    private DurakGameEngine? game;
    private Player? me;
    private Player? opponent;
    private string? opponentAvatarUrl = "images/default_avatar.png";
    private string? roomCode;
    private bool connected = false;
    private bool engineReady = false;
    private bool myTurn = false;
    private string turnText = "";
    private bool statsSent = false;
    private bool isHost => string.IsNullOrEmpty(JoinCode);

    // Turime prenumeruoti įvykį OnChange, kad persikrautų pasikeitus stalo spalvai
    protected override void OnInitialized()
    {
        // Prenumeruojame paslaugos pokyčius, kad atnaujintume UI keičiantis stalo spalvai
        CardSettingsService.OnChange += StateHasChanged;

    }

    protected override async Task OnInitializedAsync()
    {
        // Svarbu: išvalyti senus event'us prieš registruojant naujus
        GameClient.OnStartGame -= HostStartGame;
        GameClient.OnGameActionReceived -= ApplyAction;


        if (UserSession?.CurrentUser == null || UserSession.Username == "Svečias")
        {
            NavigationManager.NavigateTo("/login");
            return;
        }
        if (UserSession.CurrentUser != null)
        {
            // 1. Įkeliame Kortų Nugarėlės Spalvą
            CardSettingsService.SetCardColor(UserSession.CurrentUser.SelectedCardColor);

            // 2. Įkeliame Stalo Fono Spalvą
            CardSettingsService.SetTableColor(UserSession.CurrentUser.SelectedTableColor);
        }
        GameClient.OnStartGame += HostStartGame;
        GameClient.OnGameActionReceived += ApplyAction;

        await GameClient.ConnectAsync(UserSession.Username);
        connected = true;

        if (isHost)
        {
            roomCode = GenerateRoomCode();
            await GameClient.CreateRoomAsync(roomCode, "1v1");
        }
        else
        {
            roomCode = JoinCode;
            await GameClient.JoinRoomAsync(roomCode!);
        }

        await InvokeAsync(StateHasChanged);
    }

    private async void HostStartGame()
    {
        if (!isHost) return;

        var myName = UserSession.CurrentUser!.UserName;
        var opponentName = GameClient.ConnectedPlayers.FirstOrDefault(p => p != myName) ?? "Kitas";

        me = new Player(myName);
        opponent = new Player(opponentName);
        if (opponentName != null)
        {
            _ = FetchOpponentAvatar(opponentName);
        }
        game = new DurakGameEngine(new List<Player> { me, opponent });

        SendInitState();
        await SetupTurnsAsync();

        engineReady = true;
        UpdateTurnText();
        await InvokeAsync(StateHasChanged);
    }

    private async void SendInitState()
    {
        var trumpCard = game!.State.Deck!.TrumpCard;

        var initAction = new GameAction
        {
            Action = "INIT",
            Data =
{
["trumpCard"] = JsonSerializer.Serialize(trumpCard),
["p1cards"] = JsonSerializer.Serialize(me!.Hand),
["p2cards"] = JsonSerializer.Serialize(opponent!.Hand),
["p1name"] = me!.Name,
["p2name"] = opponent!.Name
}
        };

        await GameClient.SendGameActionAsync(initAction);
    }


    private async void ApplyInit(GameAction a)
    {
        if (isHost || engineReady) return;

        var myName = Session.CurrentUser!.UserName;

        var p1Name = a.Data.ContainsKey("p1name") ? a.Data["p1name"] : "Žaidėjas1";
        var p2Name = a.Data.ContainsKey("p2name") ? a.Data["p2name"] : "Žaidėjas2";


        // Nustatom, kas yra kas pagal prisijungusio vartotojo vardą
        string opponentName;

        if (myName == p1Name)
            opponentName = p2Name;
        else if (myName == p2Name)
            opponentName = p1Name;
        else
        {
            // jei neatitiko nei vieno – atsarginis variantas
            opponentName = p1Name;
        }

        me = new Player(myName);
        opponent = new Player(opponentName);
        _ = FetchOpponentAvatar(opponentName);


        game = new DurakGameEngine(new List<Player> { opponent!, me! });

        opponent!.Hand = JsonSerializer.Deserialize<List<Card>>(a.Data["p1cards"])!;
        me!.Hand = JsonSerializer.Deserialize<List<Card>>(a.Data["p2cards"])!;

        var trumpCard = JsonSerializer.Deserialize<Card>(a.Data["trumpCard"])!;
        game.State.TrumpSuit = trumpCard.Suit;

        // Sukuriam dummy kaladę, bet su teisingu kozeriu
        game.State.Deck = new Deck();
        game.State.Deck.OverrideTrumpCard(trumpCard);

        engineReady = true;
        UpdateTurnText();
        await InvokeAsync(StateHasChanged);
        Console.WriteLine($"[DEBUG] Mano vardas: {me.Name}");
        Console.WriteLine($"[DEBUG] Oponentas: {opponent.Name}");
        Console.WriteLine($"[DEBUG] Mano kortos: {me.Hand.Count}");
        Console.WriteLine($"[DEBUG] Oponento kortos: {opponent.Hand.Count}");
    }
    private async Task FetchOpponentAvatar(string opponentName)
    {
        try
        {
            var opponentUser = await Http.GetFromJsonAsync<User>($"api/users/byname/{opponentName}");
            if (opponentUser != null)
            {
                opponentAvatarUrl = opponentUser.AvatarUrl;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Klaida gaunant oponento avatarą: {ex.Message}");
        }
    }
    private async Task SetupTurnsAsync()
    {
        var rand = new Random();
        bool hostStarts = rand.Next(2) == 0;
        string starterTag = hostStarts ? "P1" : "P2";

        ForceStarter(starterTag);
        myTurn = hostStarts;

        var turnAction = new GameAction
        {
            Action = "SETTURN",
            Data =
{
["myTurn"] = (!hostStarts).ToString(),
["starter"] = starterTag
}
        };

        await GameClient.SendGameActionAsync(turnAction);
        UpdateTurnText();
    }

    private void ForceStarter(string starterTag)
    {
        Player starter = starterTag == "P1"
        ? (isHost ? me : opponent)!
        : (isHost ? opponent : me)!;

        var idx = game!.State.Players.IndexOf(starter);
        game.State.CurrentAttackerIndex = idx;
        game.State.CurrentDefenderIndex = (idx + 1) % game.State.Players.Count;
        game.State.Attacker = game.State.Players[game.State.CurrentAttackerIndex];
        game.State.Defender = game.State.Players[game.State.CurrentDefenderIndex];
    }

    private async Task PlayCard(Card card)
    {
        if (!myTurn || game == null || me == null) return;

        // DEFEND
        if (game.State.Defender == me)
        {
            var attackCard = game.State.TableCards.FirstOrDefault(p => p.Value == null).Key;
            if (attackCard != null && game.Defend(me!, attackCard, card))
            {

                UserSession.AddGameHistoryEntry(
                turnNumber: game.State.TurnNumber,
                player: me.Name,
                action: "DEFEND",
                cardPlayed: card,
                attackCard: attackCard
                );

                myTurn = false;
                UpdateTurnText();

                var act = new GameAction
                {
                    Action = "DEFEND",
                    Data =
{
["attackSuit"] = attackCard.Suit.ToString(),
["attackValue"] = attackCard.Value.ToString(),
["suit"] = card.Suit.ToString(),
["value"] = card.Value.ToString()
}
                };

                await GameClient.SendGameActionAsync(act);
                await InvokeAsync(StateHasChanged);
                return;
            }
        }

        // ATTACK
        if (game.Attack(me!, card))
        {

            UserSession.AddGameHistoryEntry(
            turnNumber: game.State.TurnNumber,
            player: me.Name,
            action: "ATTACK",
            cardPlayed: card
            );

            myTurn = false;
            UpdateTurnText();

            var action = new GameAction
            {
                Action = "ATTACK",
                Data =
{
["suit"] = card.Suit.ToString(),
["value"] = card.Value.ToString()
}
            };
            await GameClient.SendGameActionAsync(action);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task PickUpCards()
    {
        if (game == null || me == null) return;
        if (!myTurn) return;
        if (game.State.Defender != me) return;

        // Visada einam per host'ą – jis sutvarkys rankas, kaladę ir, jei reikia, GAME_OVER
        var request = new GameAction { Action = "REQUEST_PICKUP" };
        await GameClient.SendGameActionAsync(request);

        UserSession.AddGameHistoryEntry(
        turnNumber: game.State.TurnNumber,
        player: me!.Name,
        action: "PICKUP"
        );
        myTurn = false;
        UpdateTurnText();
        await InvokeAsync(StateHasChanged);

    }

    private async Task EndTurn()
    {
        if (!myTurn || game == null || me == null) return;
        if (!game.CanEndTurn(me!)) return;

        if (isHost)
        {
            game.EndTurn(false);

            var act = new GameAction
            {
                Action = "ENDTURN",
                Data =
{
["nextAttacker"] = game.State.Attacker.Name,
["nextDefender"] = game.State.Defender.Name,
["trump"] = game.State.TrumpSuit.ToString(),
["hands"] = JsonSerializer.Serialize(
game.State.Players.ToDictionary(p => p.Name, p => p.Hand)),
["deckCount"] = (game.State.Deck?.CardsLeft ?? 0).ToString(),
["trumpCard"] = JsonSerializer.Serialize(game.State.Deck?.TrumpCard)
}
            };

            await GameClient.SendGameActionAsync(act);

            if (isHost && game.State.IsGameOver)
            {
                var winner = game.State.Players.FirstOrDefault(p => p.Hand.Count == 0);

                var over = new GameAction
                {
                    Action = "GAME_OVER",
                    Data =
{
["winner"] = winner?.Name ?? "Niekas",
["hands"] = JsonSerializer.Serialize(
game.State.Players.ToDictionary(p => p.Name, p => p.Hand ?? new List<Card>()))
}
                };

                await GameClient.SendGameActionAsync(over);
                await RefreshUI();
            }

        }

        else
        {
            var request = new GameAction { Action = "REQUEST_ENDTURN" };
            await GameClient.SendGameActionAsync(request);
        }
        UserSession.AddGameHistoryEntry(
        turnNumber: game.State.TurnNumber,
        player: game.State.Attacker.Name,
        action: "ENDTURN"
        );
        myTurn = false;
        UpdateTurnText();
        await InvokeAsync(StateHasChanged);
    }

    private async void ApplyAction(GameAction action)
    {
        switch (action.Action)
        {
            case "INIT":
                ApplyInit(action);
                break;

            case "SETTURN":
                if (!isHost)
                    myTurn = bool.Parse(action.Data["myTurn"]);
                if (action.Data.TryGetValue("starter", out var starterTag))
                    ForceStarter(starterTag);
                break;

            case "ATTACK":
                HandleRemoteAttack(action);
                break;

            case "DEFEND":
                HandleRemoteDefend(action);
                break;

            case "REQUEST_ENDTURN":
                if (isHost && game != null)
                {
                    game.EndTurn(false);

                    var act = new GameAction
                    {
                        Action = "ENDTURN",
                        Data =
{
["nextAttacker"] = game.State.Attacker.Name,
["nextDefender"] = game.State.Defender.Name,
["trump"] = game.State.TrumpSuit.ToString(),
["hands"] = JsonSerializer.Serialize(
game.State.Players.ToDictionary(p => p.Name, p => p.Hand)),
["deckCount"] = (game.State.Deck?.CardsLeft ?? 0).ToString(),
["trumpCard"] = JsonSerializer.Serialize(game.State.Deck?.TrumpCard)
}
                    };
                    await GameClient.SendGameActionAsync(act);

                    if (game.State.IsGameOver)
                    {
                        var winner = game.State.Players.FirstOrDefault(p => p.Hand.Count == 0);

                        var over = new GameAction
                        {
                            Action = "GAME_OVER",
                            Data =
{
["winner"] = winner?.Name ?? "Niekas",
["hands"] = JsonSerializer.Serialize(
game.State.Players.ToDictionary(p => p.Name, p => p.Hand ?? new List<Card>()))
}
                        };

                        await GameClient.SendGameActionAsync(over);
                        await RefreshUI();
                    }
                }
                break;



            case "ENDTURN":
                {
                    if (action.Data.TryGetValue("nextAttacker", out var attName) &&
                    action.Data.TryGetValue("nextDefender", out var defName))
                    {
                        var att = game!.State.Players.FirstOrDefault(p => p.Name == attName);
                        var def = game.State.Players.FirstOrDefault(p => p.Name == defName);

                        if (att == null || def == null)
                        {
                            Console.WriteLine($"[WARN] Nepavyko rasti žaidėjų pagal vardus: {attName}, {defName}");
                        }
                        else
                        {
                            game.State.Attacker = att;
                            game.State.Defender = def;
                            game.State.CurrentAttackerIndex = game.State.Players.IndexOf(att);
                            game.State.CurrentDefenderIndex = game.State.Players.IndexOf(def);
                        }
                    }

                    if (action.Data.TryGetValue("hands", out var handsJson))
                    {
                        var allHands = JsonSerializer.Deserialize<Dictionary<string, List<Card>>>(handsJson)!;

                        if (allHands.TryGetValue(me!.Name, out var myCards))
                            me.Hand = myCards;

                        if (allHands.TryGetValue(opponent!.Name, out var oppCards))
                            opponent.Hand = oppCards;
                    }

                    if (action.Data.TryGetValue("deckCount", out var deckCountStr)
                    && int.TryParse(deckCountStr, out var deckCount))
                    {
                        if (deckCount <= 0)
                        {
                            // Kaladė baigėsi – parodom tuščią, bet su kozeriu
                            if (action.Data.TryGetValue("trumpCard", out var trumpJson))
                            {
                                var trump = JsonSerializer.Deserialize<Card>(trumpJson);
                                game!.State.Deck = new Deck();
                                if (trump != null)
                                    game.State.Deck.OverrideTrumpCard(trump);

                                game.State.Deck.OverrideToEmpty();
                            }
                        }
                        else
                        {
                            // Jei norėtum, čia galima būtų bandyti tvarkyti ir tikslesnį kiekį,
                            // bet tau svarbiausia – atsinaujinimas kai pasidaro 0.
                        }
                    }


                    if (action.Data.TryGetValue("trump", out var trumpSuit))
                        game!.State.TrumpSuit = Enum.Parse<Suit>(trumpSuit);

                    game!.State.TableCards.Clear();
                    myTurn = (game!.State.Attacker == me);

                    Console.WriteLine($"[INFO] ENDTURN: {me!.Name} -> Attacker: {game!.State.Attacker!.Name}, Defender: {game!.State.Defender!.Name}");
                    break;
                }


            case "REQUEST_PICKUP":
                if (isHost && game != null)
                {
                    var defender = game.State.Defender;

                    // Gynėjas pasiima visas kortas nuo stalo
                    foreach (var pair in game.State.TableCards)
                    {
                        defender.Hand.Add(pair.Key);
                        if (pair.Value != null)
                            defender.Hand.Add(pair.Value);
                    }

                    game.State.TableCards.Clear();

                    // Pabaigiam ėjimą su flag`u, kad gynėjas pasiėmė
                    game.EndTurn(true);

                    var act = new GameAction
                    {
                        Action = "PICKUP",
                        Data =
{
["hands"] = JsonSerializer.Serialize(
game.State.Players.ToDictionary(p => p.Name, p => p.Hand)),
["nextAttacker"] = game.State.Attacker.Name,
["nextDefender"] = game.State.Defender.Name,
["trump"] = game.State.TrumpSuit.ToString(),
["deckCount"] = (game.State.Deck?.CardsLeft ?? 0).ToString(),
["trumpCard"] = JsonSerializer.Serialize(game.State.Deck?.TrumpCard)
}
                    };

                    await GameClient.SendGameActionAsync(act);

                    // Jei po pickup žaidimas pasibaigė
                    if (game.State.IsGameOver)
                    {
                        var winner = game.State.Players.FirstOrDefault(p => p.Hand.Count == 0);

                        var over = new GameAction
                        {
                            Action = "GAME_OVER",
                            Data =
{
["winner"] = winner?.Name ?? "Niekas",
["hands"] = JsonSerializer.Serialize(
game.State.Players.ToDictionary(p => p.Name, p => p.Hand))
}
                        };
                        await GameClient.SendGameActionAsync(over);
                        await RefreshUI();
                    }
                }
                break;


            case "PICKUP":
                {
                    if (action.Data.TryGetValue("hands", out var handsJson))
                    {
                        var allHands = JsonSerializer.Deserialize<Dictionary<string, List<Card>>>(handsJson)!;

                        if (allHands.TryGetValue(me!.Name, out var myCards))
                            me.Hand = myCards;

                        if (allHands.TryGetValue(opponent!.Name, out var oppCards))
                            opponent.Hand = oppCards;
                    }

                    game!.State.TableCards.Clear();

                    // atnaujinam, kas atakuoja ir kas ginas
                    if (action.Data.TryGetValue("nextAttacker", out var attName) &&
                    action.Data.TryGetValue("nextDefender", out var defName))
                    {
                        var att = game.State.Players.First(p => p.Name == attName);
                        var def = game.State.Players.First(p => p.Name == defName);
                        game.State.Attacker = att;
                        game.State.Defender = def;
                        game.State.CurrentAttackerIndex = game.State.Players.IndexOf(att);
                        game.State.CurrentDefenderIndex = game.State.Players.IndexOf(def);
                    }

                    // atnaujinam kaladę, jei tuščia
                    if (action.Data.TryGetValue("deckCount", out var deckCountStr)
                    && int.TryParse(deckCountStr, out var deckCount))
                    {
                        if (deckCount <= 0)
                        {
                            if (action.Data.TryGetValue("trumpCard", out var trumpJson))
                            {
                                var trump = JsonSerializer.Deserialize<Card>(trumpJson);
                                game.State.Deck = new Deck();
                                if (trump != null)
                                    game.State.Deck.OverrideTrumpCard(trump);
                                game.State.Deck.OverrideToEmpty();
                            }
                        }
                    }

                    myTurn = (game.State.Attacker == me);
                    UpdateTurnText();
                    await InvokeAsync(StateHasChanged);
                    break;
                }

            case "GAME_OVER":
                {
                    if (game == null)
                        break;

                    game.State.IsGameOver = true;

                    if (action.Data.TryGetValue("hands", out var handsJson))
                    {
                        var allHands = JsonSerializer.Deserialize<Dictionary<string, List<Card>>>(handsJson)!;

                        foreach (var kv in allHands)
                        {
                            var player = game.State.Players.FirstOrDefault(p => p.Name == kv.Key);
                            if (player != null)
                                player.Hand = kv.Value;
                        }
                    }

                    myTurn = false;

                    // čia jau naudojam tavo RefreshUI navigacijai į /gameover/...
                    await RefreshUI();
                    break;
                }

        }


        UpdateTurnText();
        await InvokeAsync(StateHasChanged);
    }

    private void HandleRemoteAttack(GameAction action)
    {
        var suit = Enum.Parse<Suit>(action.Data["suit"]);
        var val = int.Parse(action.Data["value"]);
        var card = opponent!.Hand.FirstOrDefault(c => c.Suit == suit && c.Value == val);
        if (card != null)
            game!.Attack(opponent!, card);

        myTurn = (game!.State.Defender == me);
    }

    private void HandleRemoteDefend(GameAction action)
    {
        var asuit = Enum.Parse<Suit>(action.Data["attackSuit"]);
        var aval = int.Parse(action.Data["attackValue"]);
        var dsuit = Enum.Parse<Suit>(action.Data["suit"]);
        var dval = int.Parse(action.Data["value"]);

        var atkCard = game!.State.TableCards.Keys.FirstOrDefault(c => c.Suit == asuit && c.Value == aval);
        if (atkCard == null) return;

        var defCard = opponent!.Hand.FirstOrDefault(c => c.Suit == dsuit && c.Value == dval);
        if (defCard == null) return;

        if (!game.Defend(opponent!, atkCard, defCard)) return;

        myTurn = (game!.State.Attacker == me);
    }

    private void UpdateTurnText()
    {
        if (game == null || me == null)
        {
            turnText = "";
            return;
        }
        turnText = game.GetTurnText(me);
    }

    private Random rnd = new();
    private string GenerateRoomCode(int length = 6)
    {
        const string chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
        string core = new string(Enumerable.Repeat(chars, length)
        .Select(s => s[rnd.Next(s.Length)]).ToArray());
        return "A" + core; // prefiksas A – 1v1 žaidimams
    }

    private async Task RefreshUI()
    {


        // Jeigu jau siuntėme, išeinam iš karto
        if (statsSent)
            return;

        // Jeigu žaidimas dar nepasibaigė – irgi nieko nedarom
        if (game?.State?.IsGameOver != true)
            return;

        // Dabar pažymim, kad išsiuntėm — prieš bet kokį await
        statsSent = true;

        bool playerWon = me!.Hand.Count == 0;
        var result = playerWon ? "winner" : "loser";

        Console.WriteLine($"Game over. PlayerWon: {playerWon}");

        if (UserSession.UserId > 0)
        {
            HttpResponseMessage response;
            if (playerWon)
            {
                response = await Http.PostAsync($"api/stats/win/{UserSession.UserId}", null);
                await Http.PostAsync($"api/users/addxp/{UserSession.UserId}/100", null); // 100 XP už 1vs1 laimėjimą
                Console.WriteLine($"POST win status: {response.StatusCode}");
            }
            else
            {
                response = await Http.PostAsync($"api/stats/loss/{UserSession.UserId}", null);
                Console.WriteLine($"POST loss status: {response.StatusCode}");
            }

            // Atnaujiname sesijos duomenis po XP ir laimėjimo
            var refreshedUser = await Http.GetFromJsonAsync<User>($"api/users/{UserSession.UserId}");
            if (refreshedUser != null)
            {
                UserSession.SetUser(refreshedUser);
                Console.WriteLine($"Updated Wins: {refreshedUser.Wins}, Losses: {refreshedUser.Losses}, XP: {refreshedUser.ExperiencePoints}, Level: {refreshedUser.Level}");
            }


        }

        NavigationManager.NavigateTo($"/gameover/{result}");
        await InvokeAsync(StateHasChanged);
        return;

    }

    public void Dispose()
    {
        CardSettingsService.OnChange -= StateHasChanged;
        GameClient.OnStartGame -= HostStartGame;
        GameClient.OnGameActionReceived -= ApplyAction;
    }
}


