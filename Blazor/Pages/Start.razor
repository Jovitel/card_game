@page "/start"
@layout MainLayout
@using CardGame.Shared.Models
@using card_game.Services
@inject UserSession UserSession
@inject UserSession Session
@inject HttpClient Http
@implements IDisposable

<div class="page-wrapper">
    <div class="container">
        <div class="line">
            <div class="columns">
                <div class="line">
                    <img src="@Session.SelectedAvatarUrl" alt="Player Avatar" class="profile-avatar" />
                    <div class="column_1">
                        <input type="text" class="input-field" @bind="newUserName" /> 
                        <button class="btn-save-name" @onclick="UpdateUserName" 
                            disabled="@string.IsNullOrWhiteSpace(newUserName)">
                            Save UserName
                        </button>
                        <input type="text" class="input-field" readonly value="Wins: @UserSession.CurrentUser?.Wins" />
                        <input type="text" class="input-field" readonly
                            value="Losses: @UserSession.CurrentUser?.Losses" />
                    </div>
                </div>
                <img src="images/durnius.png" alt="Žaidimo nuotrauka" class="top-image" />
                <div>
                    <div class="line_1">
                        <div class="column svg-buttons">
                            <NavLink class="btnn" href="/settings">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none"
                                    viewBox="0 0 24 24">
                                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M21 13v-2a1 1 0 0 0-1-1h-.757l-.707-1.707.535-.536a1 1 0 0 0 0-1.414l-1.414-1.414a1 1 0 0 0-1.414 0l-.536.535L14 4.757V4a1 1 0 0 0-1-1h-2a1 1 0 0 0-1 1v.757l-1.707.707-.536-.535a1 1 0 0 0-1.414 0L4.929 6.343a1 1 0 0 0 0 1.414l.536.536L4.757 10H4a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h.757l.707 1.707-.535.536a1 1 0 0 0 0 1.414l1.414 1.414a1 1 0 0 0 1.414 0l.536-.535 1.707.707V20a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1v-.757l1.707-.708.536.536a1 1 0 0 0 1.414 0l1.414-1.414a1 1 0 0 0 0-1.414l-.535-.536.707-1.707H20a1 1 0 0 0 1-1Z" />
                                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
                                        stroke-width="2" d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" />
                                </svg>
                            </NavLink>
                            <NavLink class="btnn" href="/rules">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none"
                                    viewBox="0 0 24 24">
                                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M9.529 9.988a2.502 2.502 0 1 1 5 .191A2.441 2.441 0 0 1 12 12.582V14m-.01 3.008H12M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                                </svg>
                            </NavLink>
                            <NavLink class="btnn" href="/friends">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor"
                                    viewBox="0 0 24 24">
                                    <path fill-rule="evenodd"
                                        d="M8 4a4 4 0 1 0 0 8 4 4 0 0 0 0-8Zm-2 9a4 4 0 0 0-4 4v1a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2v-1a4 4 0 0 0-4-4H6Zm7.25-2.095c.478-.86.75-1.85.75-2.905a5.973 5.973 0 0 0-.75-2.906 4 4 0 1 1 0 5.811ZM15.466 20c.34-.588.535-1.271.535-2v-1a5.978 5.978 0 0 0-1.528-4H18a4 4 0 0 1 4 4v1a2 2 0 0 1-2 2h-4.535Z"
                                        clip-rule="evenodd" />
                                </svg>
                            </NavLink>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="columns">
            <div class="center-column">
                <div class="square leaderboard">
                    <h3>Scoreboard</h3>

                    @if (scoreboard == null)
                    {
                        <p>Kraunama...</p>
                    }
                    else if (!scoreboard.Any())
                    {
                        <p>Nėra duomenų.</p>
                    }
                    else
                    {
                        <div class="leaderboard-list">
                            @foreach (var (player, index) in scoreboard.Select((p, i) => (p, i + 1)))
                            {
                                <div class="leader-row @(player.Id == UserSession.UserId ? "me" : "")">
                                    <span class="rank">@index.</span>
                                    <span class="name">@player.UserName</span>
                                    <span class="score"> @player.Wins</span>
                                    <span class="losses"> @player.Losses</span>
                                </div>
                            }
                        </div>
                    }
                </div>


            </div>
            <div class="center-column">
                <NavLink class="btn" href="/vs">Start game</NavLink>
                <NavLink class="btn" href="/join">Join game</NavLink>
                <NavLink class="btn" href="/">Leave</NavLink>
            </div>
            <div class="right">
                <img src="images/cards_light.png" alt="Kortu nuotrauka" class="card-image" />
            </div>
            @if (!string.IsNullOrWhiteSpace(errorMessage))
                        {
                            <div class="error-message">@errorMessage</div>
                        }
        </div>
    </div>
</div>
@code {
    private string newUserName = "";
    private string errorMessage = "";
    protected override void OnInitialized()
    {
        // Prenumeruojame Session paslaugos įvykį, kad puslapis atnaujintų vaizdą
        Session.OnChange += StateHasChanged;
        
        // PAKEITIMAS: Nustatome pradinę reikšmę naujam laukui
        newUserName = GetPlayerName(); 
    }
    
    // BŪTINA: Atšaukiame prenumeratą, kai komponentas sunaikinamas, 
    // kad išvengtume atminties nuotėkio
    public void Dispose()
    {
        Session.OnChange -= StateHasChanged;
    }
    private string GetPlayerName()
    {
        return UserSession.UserId > 0
        ? UserSession.CurrentUser?.UserName ?? "Guest"
        : "Guest";
    }

    private List<User> scoreboard = new();

    protected override async Task OnInitializedAsync()
    {
        newUserName = GetPlayerName();
        await LoadScoreboard();
    }
    private async Task LoadScoreboard()
    {
        if (UserSession.UserId <= 0)
        {
            scoreboard = new();
            return;
        }

        // Pasiimame draugus
        var friends = await Http.GetFromJsonAsync<List<User>>($"api/friends/{UserSession.UserId}") ?? new();

        // Pridedame patį vartotoją, jei jo nėra sąraše
        if (UserSession.CurrentUser != null && !friends.Any(f => f.Id == UserSession.CurrentUser.Id))
        {
            friends.Add(UserSession.CurrentUser);
        }

        // Rikiuojame pagal laimėjimus, tada pralaimėjimus
        scoreboard = friends
        .OrderByDescending(f => f.Wins)
        .ThenBy(f => f.Losses)
        .ThenBy(f => f.UserName)
        .ToList();

        StateHasChanged();
    }
        private async Task UpdateUserName()
    {
        errorMessage = ""; 

    if (string.IsNullOrWhiteSpace(newUserName) || UserSession.CurrentUser == null)
    {
        errorMessage = "UserName cannot be empty.";
        return;
    }


    try
    {
        var updateData = new 
        {
            UserId = UserSession.CurrentUser.Id,
            NewUserName = newUserName.Trim() 
        };

        // Naudojame PUT metodą, kuris dabar yra palaikomas API kontroleryje
        var response = await Http.PutAsJsonAsync("api/users/updateusername", updateData); 

        if (response.IsSuccessStatusCode)
        {
            // Viskas gerai: atnaujiname sesiją
            UserSession.CurrentUser.UserName = newUserName.Trim();                
            Session.NotifyChange(); 
            await LoadScoreboard();
        }
        else
        {
            // API atsako klaida
            if (response.StatusCode == System.Net.HttpStatusCode.Conflict) // 409
            {
                errorMessage = "This UserName is already taken.";
            }
            else // Kitos klaidos (404, 400, 500 ir t.t.)
            {
                // Paimame klaidos tekstą iš API (jei API grąžina tekstą)
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Nepavyko atnaujinti vardo. Statusas: {(int)response.StatusCode}. Žinutė: {errorContent}";
            }
        }
        }
        catch (Exception ex)
        {
            errorMessage = $"Įvyko nenumatyta klaida: {ex.Message}";
            Console.WriteLine($"Klaida: {ex.Message}");
        }
    }
}

<style>
    .column_1 {
        display: flex;
        flex-direction: column;
        /* vienas po kito */
        gap: 5px;
        /* tarpai tarp laukelių */
    }

    .card-image {
        width: 250px;
    }

    .right {
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        /* vertikaliai – apačioj */
        align-items: flex-end;
        /* horizontaliai – prie pat dešinio krašto */
        gap: 20px;
        height: 100%;
    }

    .center-column {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 20px;
        height: 100%;
    }

    .page-wrapper {
        background-color: #2c425a;
        display: flex;
        justify-content: center;
        align-items: center;
