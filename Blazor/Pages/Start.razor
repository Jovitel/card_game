        height: 70px;
        width: 70px;
    }

    .columns {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        align-items: start;
        width: 100%;
    }

    .top-image {
        width: 350px;
        height: auto;
        margin-bottom: 30px;
        border-radius: 12px;
        justify-content: center;
        align-items: center;
    }

    .img {
        width: 150px;
        height: auto;
        border-radius: 12px;
        justify-content: center;
        align-items: left;
    }

    .line {
        display: flex;
        flex-direction: row;
        gap: 10px;
        justify-content: flex-start;
    }

    .line_1 {
        display: flex;
        flex-direction: row;
        gap: 10px;
        justify-content: flex-end;
    }

    .btn {
        background-color: #2c425a;
        color: white;
        padding: 12px;
        border: none;
        border-radius: 8px;
        font-size: 16px;
        font-weight: bold;
        cursor: pointer;
        transition: 0.3s;
