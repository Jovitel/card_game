        box-sizing: border-box;
    }

    .container {
        background: #a2c2de;
        width: 98%;
        max-width: 1300px;
        min-height: 500px;
        padding: 10px 0 10px 10px;
        /* viršus 10px, dešinė 0px, apačia 10px, kairė 10px */
        border-radius: 12px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
    }

    .column {
        display: flex;
        flex-direction: column;
        gap: 15px;
        max-width: 150px;
        justify-items: center;
    }

    .column_1 {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .input-field {
        padding: 8px;
        border: 2px solid #2c425a;
