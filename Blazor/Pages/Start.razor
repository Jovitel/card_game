        padding: 15px 10px;
        box-sizing: border-box;
    }

    .leaderboard h3 {
        color: #2c425a;
        text-align: center;
        margin-bottom: 12px;
        font-size: 22px;
        font-weight: 700;
    }

    .leaderboard-list {
        display: flex;
        flex-direction: column;
        width: 100%;
        background: #ffffff;
        border-radius: 8px;
        overflow: hidden;
    }

    .leader-row {
        display: grid;
        grid-template-columns: 40px 1fr 50px 50px;
        align-items: center;
        padding: 6px 10px;
        border-bottom: 2px solid #2c425a;
        font-weight: 600;
        color: #1c2d3e;
        text-align: center;
    }

    .leader-row.me {
        background-color: #f0e1b4;
        font-weight: 700;
    }

    .leader-row:last-child {
        border-bottom: none;
    }
    .svg-buttons {
        display: flex;
        flex-direction: row;
        gap: 15px;
        align-items: flex-end;
        justify-content: flex-end;
        width: 100%;
        padding: 10px;
    }

    .btnn {
        background: none;
        border: none;
        padding: 0;
        cursor: pointer;
    }

    .btnn svg {
        width: 32px;
        height: 32px;
        color: #2c425a;
        transition: 0.3s;
    }

    .btnn:hover svg {
        color: #56708c;
    }
    .profile-avatar {
    border: 2px solid #2c425a;
    border-radius: 50%; /* Padaro apvalų */
    height: 70px;
    width: 70px;
    object-fit: cover; /* Užtikrina, kad paveikslėlis tilps */
    padding: 0; 
}
.btn-save-name {
        background-color: #2c425a;
        color: white;
        padding: 5px 12px;
        border: none;
        border-radius: 20px;
        font-size: 14px;
        font-weight: bold;
        cursor: pointer;
        transition: 0.3s;
        max-height: 36px; /* Siekiant, kad būtų kompaktiškesnis */
    }

    .btn-save-name:hover:not(:disabled) {
        background-color: #56708c;
        color: #f0e1b4;
    }

    .btn-save-name:disabled {
        background-color: #aaa;
        cursor: not-allowed;
        opacity: 0.7;
    }
    .error-message {
        color: #f0e1b4; /* Raudona spalva klaidoms */
        background-color: #56708c; 
        border: 1px solid #2c425a;
        padding: 5px 10px;
        border-radius: 5px;
        font-size: 14px;
        font-weight: 600;
        text-align: center;
    }
    .error-message:contains("sėkmingai") {
        color: #008000;
        background-color: #ddf;
        border-color: #008000;
    }
</style>