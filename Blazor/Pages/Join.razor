@page "/join"
@layout MainLayout
@inject NavigationManager Nav

<h3>Prisijungti prie žaidimo</h3>

<input @bind="roomCode" placeholder="Įvesk kambario kodą" />
<button @onclick="JoinGame">Prisijungti</button>

@code {
    private string? roomCode;

    private void JoinGame()
    {
        if (!string.IsNullOrWhiteSpace(roomCode))
        {
            Nav.NavigateTo($"/game/1vs1/{roomCode}");
        }
    }
}
