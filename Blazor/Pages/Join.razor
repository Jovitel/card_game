@page "/join"
@layout MainLayout
@inject NavigationManager Nav

<div class="join-page">
    <div class="join-box">
        <h2 class="join-title">Prisijungti prie žaidimo</h2>

        <input @bind="roomCode" placeholder="Įvesk kambario kodą" class="join-input" />

        <button class="join-button" @onclick="JoinGame">Prisijungti</button>
    </div>
</div>

@code {
    private string? roomCode;

    private void JoinGame()
    {
        if (!string.IsNullOrWhiteSpace(roomCode))
        {
            // Nusprendžiam pagal pirmą raidę, kur nukreipti
            var code = roomCode.Trim().ToUpper();

            if (code.StartsWith("A"))
                Nav.NavigateTo($"/game/1vs1/{code}");
            else if (code.StartsWith("M"))
                Nav.NavigateTo($"/game/1vsmulti/{code}");
            else
                Console.WriteLine("Neteisingas kambario kodas: nežinomas prefiksas!");
        }
    }
}
<style>
/* Vienodas aukštis visiems laukams */
.join-input,
.join-button {
    height: 48px;
    box-sizing: border-box;
}

/* Puslapio fonas ir išdėstymas */
.join-page {
    background-color: var(--bg-color);
    color: var(--text-color);
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s, color 0.3s;
}

/* Pagrindinė dėžutė */
.join-box {
    background-color: var(--container-bg);
    border: 2px solid var(--accent-color);
    border-radius: 20px;
    padding: 40px 60px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
    text-align: center;
    transition: background-color 0.3s, border-color 0.3s;
}

/* Pavadinimas */
.join-title {
    color: var(--highlight-color);
    font-size: 28px;
    margin-bottom: 25px;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
}

/* Įvesties laukelis */
.join-input {
    width: 250px;
    padding: 0 15px;
    border-radius: 10px;
    border: 2px solid var(--accent-color);
    background-color: var(--input-bg);
    color: var(--text-color);
    font-size: 18px;
    text-align: center;
    outline: none;
    transition: border-color 0.2s ease, background-color 0.2s ease, color 0.3s;
    margin-bottom: 15px;
}

.join-input::placeholder {
    color: var(--placeholder-color);
}

.join-input:focus {
    border-color: var(--highlight-color);
    background-color: var(--input-bg-focus);
}

/* Prisijungimo mygtukas */
.join-button {
    width: 250px;
    border: none;
    border-radius: 10px;
    background-color: var(--btn-bg);
    color: var(--btn-text);
    font-size: 18px;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.2s ease;
}

.join-button:hover {
    background-color: var(--btn-bg-hover);
    transform: translateY(-2px);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
}
</style>
