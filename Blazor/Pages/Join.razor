@page "/join"
@layout MainLayout
@inject NavigationManager Nav

<div class="join-page">
    <div class="join-box">
        <h2 class="join-title">Prisijungti prie žaidimo</h2>

        <input @bind="roomCode" placeholder="Įvesk kambario kodą" class="join-input" />

        <button class="join-button" @onclick="JoinGame">Prisijungti</button>
    </div>
</div>

@code {
    private string? roomCode;

    private void JoinGame()
    {
        if (!string.IsNullOrWhiteSpace(roomCode))
        {
            // Nusprendžiam pagal pirmą raidę, kur nukreipti
            var code = roomCode.Trim().ToUpper();

            if (code.StartsWith("A"))
                Nav.NavigateTo($"/game/1vs1/{code}");
            else if (code.StartsWith("M"))
                Nav.NavigateTo($"/game/1vsmulti/{code}");
            else
                Console.WriteLine("Neteisingas kambario kodas: nežinomas prefiksas!");
        }
    }
}

<style>

.join-input,
.join-button {
    height: 48px; /* vienodas aukštis visiems */
    box-sizing: border-box;
}

.join-page {
    background-color: #2c425a;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
}

.join-box {
    background-color: rgba(255, 255, 255, 0.05);
    border: 2px solid #f0e1b4;
    border-radius: 20px;
    padding: 40px 60px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.4);
    text-align: center;
}

.join-title {
    color: #f0e1b4;
    font-size: 28px;
    margin-bottom: 25px;
    text-shadow: 0 2px 6px rgba(0,0,0,0.3);
}
/* Kad viskas išliktų vizualiai suderinta */
.join-input{
    width: 250px;
    padding: 0 15px; /* nulinis vertikalus padding, kad netemptų aukščio */
    border-radius: 10px;
    border: 2px solid #f0e1b4;
    background-color: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    font-size: 18px;
    text-align: center;
    outline: none;
    transition: border-color 0.2s ease, background-color 0.2s ease;
    margin-bottom: 15px;
}

/* Mygtukui taip pat taikome vienodą stilių */
.join-button {
    width: 250px; /* kad būtų vienodo pločio kaip ir kiti */
    border: none;
    border-radius: 10px;
    background-color: #f0e1b4;
    color: #2c425a;
    font-size: 18px;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.2s ease;
}

.join-button:hover {
    background-color: #ffd97a;
    transform: translateY(-2px);
    box-shadow: 0 4px 10px rgba(0,0,0,0.3);
}
.join-input::placeholder {
    color: #cccccc;
}
.join-input:focus {
    border-color: #ffd97a;
    background-color: rgba(255, 255, 255, 0.15);
}



</style>
