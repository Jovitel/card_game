@using card_game.Services
@using CardGame.Shared.Models
@inject GameClientService GameClient
@inject UserSession UserSession
@implements IDisposable

<div class="chat-window">
    <div class="chat-header">Chat</div>
    
    <div class="chat-messages" @ref="messagesContainer">
        @foreach (var message in GameClient.Messages)
        {
            <div class="message-row @(message.SenderName == UserSession.Username ? "mine" : "opponent")">
                <span class="sender-name">@(message.SenderName == UserSession.Username ? "You" : message.SenderName)</span>
                <span class="message-text">@message.Message</span>
            </div>
        }
    </div>

    <div class="chat-input-area">
        <input @bind-value="newMessage" 
               @onkeypress="HandleInput"
               placeholder="" 
               maxlength="100" />
        <button @onclick="SendMessage" disabled="@string.IsNullOrWhiteSpace(newMessage)">Send</button>
    </div>
</div>

@code {
    private string newMessage = string.Empty;
    private ElementReference messagesContainer;
    
    protected override void OnInitialized()
    {
        // Prenumeruojame įvykį, kad gautume pranešimus ir atnaujintume UI
        GameClient.OnMessageReceived += OnMessageReceived;
        GameClient.OnChatHistoryReceived += OnChatHistoryReceived;
        GameClient.OnChatHistoryReceived -= OnChatHistoryReceived;
    }

    public void Dispose()
    {
        GameClient.OnMessageReceived -= OnMessageReceived;
    }

    private void OnMessageReceived(ChatMessage message)
    {
        // Perkrauname puslapį, kad atsinaujintų sąrašas
        InvokeAsync(StateHasChanged);
    }
    private void OnChatHistoryReceived(List<ChatMessage> history)
    {
        // Po to, kai GameClient atnaujino Messages sąrašą, atnaujiname UI
        InvokeAsync(StateHasChanged);
        // Čia taip pat būtų vieta iškviesti ScrollToBottom.
    }
    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(newMessage)) return;

        await GameClient.SendChatMessageAsync(newMessage.Trim());
        newMessage = string.Empty; // Išvalome įvesties lauką
        
        // Perkrauname puslapį iškart po siuntimo
        await InvokeAsync(StateHasChanged);
    }

    // Leidžia siųsti žinutę paspaudus Enter
    private async Task HandleInput(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendMessage();
        }
    }
    
    // Užtikrina, kad sąrašas nuslinktų į apačią, kai atsiranda nauja žinutė
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (GameClient.Messages.Count > 0)
        {
            // JavaScript iškvietimas, kad nuslinktų į apačią
            await ScrollToBottom();
        }
    }

    private async Task ScrollToBottom()
    {
       
    }
}
<style>
/* --- Pokalbių lango stiliai --- */
.chat-container-wrapper {
    position: fixed;
    right: 20px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 50; /* Kad būtų virš kitų elementų */
}

.chat-window {
    width: 280px;
    height: 300px;
    background-color: #a2c2de; /* Šviesesnis fonas */
    border: 3px solid #2c425a;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
}

.chat-header {
    background-color: #2c425a;
    color: white;
    padding: 10px;
    font-weight: bold;
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    text-align: center;
}

.chat-input-area {
    display: flex;
    padding: 10px;
    border-top: 2px solid #2c425a;
    gap: 5px;
}

.chat-input-area input {
    flex-grow: 1;
    padding: 8px;
    border-radius: 5px;
    border: 1px solid #ccc;
}

.chat-input-area button {
    background-color: #2c425a; /* Pagrindinė spalva: tamsiai mėlyna/pilka */
    color: white;
    border: none;
    border-radius: 5px; 
    padding: 8px 12px;
    cursor: pointer;
    font-weight: 600;
    transition: 0.3s; /* Pridėtas perėjimas */
}


.chat-input-area button:hover:not(:disabled) {
    background-color: #56708c; 
    color: #f0e1b4; 
}


.chat-input-area button:disabled {
    background-color: #2c425a; 

}
.chat-input-area button:hover:disabled {
    background-color: #56708c; 
    color: #f0e1b4; 
}
.chat-messages {
    flex-grow: 1;
    padding: 10px;
    overflow-y: auto; 
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.message-row {
    padding: 6px 10px;
    border-radius: 10px;
    max-width: 80%;
    display: flex;
    flex-direction: column;
}

.message-row.mine {
    background-color: #f0e1b4; /* Tavo žinutės */
    align-self: flex-end;
    margin-left: auto;
}

.message-row.opponent {
    background-color: #ffffff; /* Kito žaidėjo žinutės */
    align-self: flex-start;
    margin-right: auto;
}

.sender-name {
    font-size: 10px;
    font-weight: bold;
    color: #56708c;
    margin-bottom: 2px;
}
.message-text {
    font-size: 14px;
    word-wrap: break-word; /* Leidžia ilgiems žodžiams lūžti */
}
</style>