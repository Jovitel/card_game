@page "/rules"
@layout MainLayout
<div class="page-wrapper">
    <div class="container">
        <div class="top-line">
            <img src="images/durnius.png" alt="Žaidimo nuotrauka" class="top-image" />
            <NavLink class="btn" href="/start">Exit</NavLink>
        </div>
        <div class="rules-square">
            <h2>Game Rules</h2>
            <ul>
                <li class="spade" data-suit="♠">Each player is dealt 6 cards.</li>
                <li class="heart" data-suit="♥">The trump suit is determined randomly.</li>
                <li class="diamond" data-suit="♦">Attack and defense happen in turns.</li>
                <li class="club" data-suit="♣">Players must beat attacking cards with higher or trump cards.</li>
                <li class="spade" data-suit="♠">If unable to beat, pick up the cards.</li>
                <li class="heart" data-suit="♥">First to get rid of all cards wins.</li>
            </ul>
        </div>
    </div>
</div>

<style>
.page-wrapper {
    background-color: #2c425a;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    padding: 5px;
    box-sizing: border-box;
}

.container {
    background: #a2c2de;
    width: 98%;
    max-width: 1300px;
    min-height: 500px;
    padding: 10px;
    border-radius: 12px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.2);
    display: flex;
    flex-direction: column;
    align-items: center;
}
.top-line {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
}

.top-image {
    width: 230px;
    height: auto;
    border-radius: 12px;
}

.btn {
    background-color: #2c425a;
    color: white;
    padding: 12px;
    border: 3px;
    border-radius: 8px;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
    transition: 0.3s;
    text-decoration: none;
    text-align: center;
    min-width: 180px;
}

.btn:hover {
    background-color: #56708c;
    color: #f0e1b4;
}
.rules-square {
    width: 570px;
    min-height: 400px;
    background-color: #ffffffff;
    color: #2c425a;
    border-radius: 14px;
    border: 5px solid #2c425a;
    padding: 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: left;
    box-shadow: 0 4px 10px rgba(0,0,0,0.3);
    margin-bottom: 10px;
}

.rules-square h2 {
    text-align: center;
    margin-bottom: 20px;
}

.rules-square ul {
    list-style: none;
    padding: 0;
}

.rules-square li {
    font-size: 18px;
    margin-bottom: 10px;
}

.rules-square li::before {
    content: attr(data-suit) " "; 
    font-weight: bold;
}

.spade::before { color: black; }
.club::before { color: black; }
.heart::before { color: red; }
.diamond::before { color: red; }
</style>
