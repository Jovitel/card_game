@page "/join"
@layout MainLayout

<div class="page-wrapper">
    <div class="container">
        <div class="top-line">
            <img src="images/durnius.png" alt="Žaidimo nuotrauka" class="top-image" />
            <NavLink class="btn" href="/start">Exit</NavLink>
        </div>
        <div class="row">
            <div class="square">Join game code:</div>
            <div class="square">Joined game:</div>
        </div>
        <div class="start-btn-wrapper">
            <NavLink class="btn" href="/game">Start Game</NavLink>
        </div>
    </div>
</div>

<style>
.page-wrapper {
    background-color: #2c425a;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    padding: 5px;
    box-sizing: border-box;
}

.container {
    background: #a2c2de;
    width: 98%;
    max-width: 1300px;
    min-height: 500px;
    padding: 10px;
    border-radius: 12px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.2);
    display: flex;
    flex-direction: column;
    align-items: center;
}

/* Nuotrauka ir Exit mygtukas vienoje eilutėje */
.top-line {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    margin-bottom: 30px;
}

.top-image {
    width: 230px;
    height: auto;
    border-radius: 12px;
}

.btn {
    background-color: #2c425a;
    color: white;
    padding: 12px;
    border: 3px;
    border-radius: 8px;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
    transition: 0.3s;
    text-decoration: none;
    text-align: center;
    min-width: 180px;
}

.btn:hover {
    background-color: #56708c;
    color: #f0e1b4;
}

/* Eilutė su kvadratais */
.row {
    display: flex;
    justify-content: center;
    gap: 40px; /* tarpas tarp kvadratų */
    margin-top: 40px; /* tarpas nuo viršutinės eilutės */
    width: 100%;
}

/* Kvadratų stilius */
.square {
    width: 150px;
    height: 150px;
    background-color: #2c425a;
    border-radius: 12px;
    border: 7px solid #ffffffff;
    display: flex;
    justify-content: center;
    align-items: center;
    color: #f0e1b4;
    font-weight: bold;
    font-size: 18px;
    cursor: pointer;
    transition: 0.3s;
}

.square:hover {
    background-color: #56708c;
}
.start-btn-wrapper {
    margin-top: 50px; 
    display: flex;
    justify-content: center;
    width: 100%;
}
</style>
