@page "/"
<div class="layout-container">
    <div class="content-wrapper">
        <img src="images/cards.png" alt="Kortu nuotrauka" class="card-image" />
        <div class="page-body">
            <div class="index-container">
                <img src="images/durnius.png" alt="Žaidimo nuotrauka" class="top-image" />

                <div class="button-container">
                    <NavLink class="btn" href="/login">Log in</NavLink>
                    <NavLink class="btn" href="/register">Register</NavLink>
                </div>
            </div>
        </div>
        <img src="images/cards_right.png" alt="Kortu nuotrauka" class="card-image" />

    </div>
</div>
<style>
.index-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 20px;
}

.top-image {
    width: 350px;       /* gali pakeisti dydį pagal poreikį */
    height: auto;
    margin-bottom: 30px;
    border-radius: 12px;
}

.button-container {
    display: flex;
    flex-direction: column; /* mygtukai vienas po kito */
    gap: 15px;             /* tarpas tarp mygtukų */
}

.btn {
    background-color: #2c425a;
    color: white;
    padding: 12px;
    border: none;
    border-radius: 8px;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
    transition: 0.3s;
    text-decoration: none;
    text-align: center;
    width:200px;
}

.btn:hover {
    background-color: #56708c;
    color: #f0e1b4;
}
.page-body {
        background: #a2c2de;
        border-radius: 12px;    
        max-width: 1000px; 
        min-height: 400px; 
    }
/* Bendras fonas */
.layout-container {
    background-color: #2c425a; 
    height: 100vh;           
    display: flex;
    align-items: center;     
    justify-content: center;  
    flex-direction: column;
}
.content-wrapper {
    display: flex;          /* išdėstome eilute */
    flex-direction: row;    /* horizontaliai */
    align-items: center;    /* centruoja vertikaliai */
}

.card-image {
    width: 250px;   /* pritaikyk pagal poreikį */
    height: auto;
}
</style>